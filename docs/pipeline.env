: "${APP_NAME:=Whoosh}"
: "${APP_PROJECT:=build/<label>/project/Whoosh.xcodeproj}"
: "${APP_SCHEME:=Whoosh}"
: "${BUILD_CMD:=sh scripts/build-mac.sh}"
: "${BUILD_ROOT:=build}"
: "${BUNDLE_REL:=Build/Products/Debug/Whoosh.app}"
: "${INSTALL_DIR:=$HOME/Applications}"
: "${KEEP_CAP:=3}"
# Hidden rig root (owner 2026-11-08 16:30: no test window on the screen, ever). The old root
# Whoosh-rig is chmod 500 on this Mac: a branch without the hidden-mode guard in launch-one.sh
# fails at mkdir there. Only guarded launches (WHOOSH_RIG_HIDDEN=1 + rig-hidden.ok) reach this one.
: "${RIG_ROOT:=$HOME/Library/Application Support/Whoosh-rig-hidden}"
: "${QUEUE_DIR:=$RIG_ROOT/queue}"   # under the hidden rig root; the old Whoosh-rig root is chmod 500 (tests-r2 found round.sh failing on it, 2026-11-08 21:30)
: "${SOCKET_ENV:=WHOOSH_SOCKET_DIR}"
: "${SOCKET_NAME:=whoosh.sock}"
: "${SIGN_IDENTITY:=-}"
: "${CRASH_DIR:=$HOME/Library/Logs/DiagnosticReports}"
: "${BUILD_PROC_MATCH:=xcodebuild}"
: "${DISK_FLOOR_GB:=20}"
: "${WORKTREE_REPO:=$(cd "$(dirname "$0")/.." && pwd)}"   # the repo the script that reads this file sits in
# Confirmed by the contracts lane at the root commit (2026-11-07): APP_PROJECT, APP_SCHEME and BUNDLE_REL hold for the xcodegen project; BUILD_CMD runs scripts/build-mac.sh (Rust core, generated Swift, xcodegen into the build tree, xcodebuild Debug); APP_PROJECT is informative only, since BUILD_CMD is set. 2026-11-07: the Xcode projects are no longer tracked; apps/*/project.yml is the source. INSTALL_DIR is the user's Applications folder during the unattended build; /Applications after the owner's first review.
: "${ROUND_CELL_BUDGET_S:=600}"   # see docs/CONSTANTS.md
