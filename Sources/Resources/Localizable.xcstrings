    "Rules file first. The decision model files the rest by meaning.": {
      "comment": "Sources/Features/LabelsContactsMac/LabelInspectorRules.swift:22. machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Reglerne sorterer først. Beslutningsmodellen sorterer resten efter mening."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Regeln sortieren zuerst. Das Entscheidungsmodell sortiert den Rest nach Bedeutung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rules file first. The decision model files the rest by meaning."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero clasifican las reglas. El modelo de decisión clasifica el resto por significado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Säännöt lajittelevat ensin. Päätösmalli lajittelee loput merkityksen mukaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les règles classent d’abord. Le modèle de décision classe le reste selon le sens."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima classificano le regole. Il modello decisionale classifica il resto per significato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まずルールで分類し、残りは判断モデルが意味で分類します。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Reglene sorterer først. Beslutningsmodellen sorterer resten etter mening."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Regels delen eerst in. Het beslismodel deelt de rest in op betekenis."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw działają reguły. Model decyzji przypisuje resztę według znaczenia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As regras classificam primeiro. O modelo de decisão classifica o resto pelo significado."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Reglerna sorterar först. Beslutsmodellen sorterar resten efter betydelse."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先按规则归类，其余由决策模型按含义归类。"
          }
        }
      }
    },
    "Rules only. A re-run also files by meaning.": {
      "comment": "Sources/Features/LabelsContactsMac/LabelProofViews.swift:90. machine-translated, owner review pending.",
