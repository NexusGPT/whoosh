    "It moves your accounts, names, colours, order and signatures. Passwords travel through iCloud Keychain, never in this code.": {
      "comment": "WelcomeMac (Sources/Features/WelcomeMac/WelcomeQR.swift:72). machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den flytter dine konti, navne, farver, rækkefølge og signaturer. Adgangskoder rejser via iCloud Keychain, aldrig i denne kode."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es überträgt Ihre Accounts, Namen, Farben, Reihenfolge und Signaturen. Passwörter laufen über den iCloud-Schlüsselbund, nie über diesen Code."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It moves your accounts, names, colours, order and signatures. Passwords travel through iCloud Keychain, never in this code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mueve tus cuentas, nombres, colores, orden y firmas. Las contraseñas viajan por iCloud Keychain, nunca en este código."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se siirtää tilisi, nimet, värit, järjestyksen ja allekirjoitukset. Salasanat kulkevat iCloud-avainnipun kautta, eivät koskaan tässä koodissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il transfère vos comptes, noms, couleurs, ordre et signatures. Les mots de passe passent par le Trousseau iCloud, jamais par ce code."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sposta i tuoi account, nomi, colori, ordine e firme. Le password viaggiano tramite iCloud Keychain, mai in questo codice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント、名前、カラー、順序、署名が移ります。パスワードはこのコードではなく、iCloudキーチェーンで転送されます。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den flytter kontoene, navnene, fargene, rekkefølgen og signaturene dine. Passord reiser via iCloud Keychain, aldri i denne koden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het verplaatst je accounts, namen, kleuren, volgorde en handtekeningen. Wachtwoorden gaan via iCloud Keychain, nooit via deze code."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przenosi Twoje konta, nazwy, kolory, kolejność i podpisy. Hasła podróżują przez iCloud Keychain, nigdy w tym kodzie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Move suas contas, nomes, cores, ordem e assinaturas. As senhas viajam pelo iCloud Keychain, nunca neste código."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det flyttar dina konton, namn, färger, ordning och signaturer. Lösenord färdas via iCloud Keychain, aldrig i den här koden."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它会转移你的账户、名称、颜色、顺序和签名。密码通过iCloud钥匙串传输,绝不经过此代码。"
          }
        }
      }
    },
