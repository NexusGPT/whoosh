        }
      }
    },
    "Whoosh has not asked yet. It reads your events and never writes one.": {
      "comment": "SettingsCalendarsMac, settings-integrate (Sources/Features/SettingsCalendarsMac/CalendarWords.swift). machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoosh har ikke spurgt endnu. Den læser dine begivenheder og skriver aldrig nogen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoosh hat noch nicht angefragt. Es liest Ihre Termine und schreibt nie einen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoosh has not asked yet. It reads your events and never writes one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoosh aún no lo ha solicitado. Lee tus eventos y nunca escribe ninguno."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoosh ei ole vielä pyytänyt lupaa. Se lukee tapahtumasi eikä kirjoita yhtään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoosh n’a pas encore demandé. Il lit vos événements et n’en écrit jamais."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoosh non l’ha ancora richiesto. Legge i tuoi eventi e non ne scrive mai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Whooshはまだ許可を求めていません。予定を読み取るだけで、書き込むことはありません。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoosh har ikke spurt ennå. Den leser avtalene dine og skriver aldri noen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoosh heeft het nog niet gevraagd. Het leest je afspraken en schrijft er nooit een."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoosh jeszcze nie poprosił o dostęp. Czyta Twoje wydarzenia i nigdy żadnego nie zapisuje."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Whoosh ainda não pediu. Ele lê os seus eventos e nunca escreve nenhum."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoosh har inte frågat ännu. Den läser dina händelser och skriver aldrig någon."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoosh 尚未请求权限。它只读取你的日程，从不写入。"
          }
        }
      }
    },
    "Whoosh keeps your mail on this Mac. Turning notifications off only stops the banners and sounds for that account.": {
      "comment": "SettingsAccountsMac (Sources/Features/SettingsAccountsMac/AccountsWords.swift:20). machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoosh beholder din mail på denne Mac. Hvis du slår underretninger fra, stopper kun bannere og lyde for den konto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoosh behält Ihre Mail auf diesem Mac. Wenn Sie Mitteilungen ausschalten, entfallen nur Banner und Töne für diesen Account."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoosh keeps your mail on this Mac. Turning notifications off only stops the banners and sounds for that account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoosh guarda tu correo en este Mac. Desactivar las notificaciones solo detiene los avisos y sonidos de esa cuenta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoosh säilyttää postisi tällä Macilla. Ilmoitusten poistaminen käytöstä vain estää kyseisen tilin bannerit ja äänet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoosh garde votre courrier sur ce Mac. Désactiver les notifications n’arrête que les bannières et les sons de ce compte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoosh tiene la tua posta su questo Mac. Disattivare le notifiche ferma solo i banner e i suoni di quell’account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "WhooshはメールをこのMacに保管します。通知をオフにしても、そのアカウントのバナーと音が止まるだけです。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoosh beholder e-posten din på denne Macen. Å slå av varsler stopper bare bannere og lyder for den kontoen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoosh bewaart je mail op deze Mac. Meldingen uitzetten stopt alleen de banners en geluiden voor dat account."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoosh trzyma Twoją pocztę na tym Macu. Wyłączenie powiadomień wstrzymuje tylko banery i dźwięki dla tego konta."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Whoosh guarda seu e-mail neste Mac. Desativar as notificações só interrompe os avisos e sons dessa conta."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoosh behåller din e-post på den här Macen. Att stänga av aviseringar stoppar bara banderoller och ljud för det kontot."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoosh将你的邮件保存在这台Mac上。关闭通知只会停止该账户的横幅和声音。"
          }
        }
      }
    },
    "Whoosh looks for JMAP, then for IMAP settings.": {
