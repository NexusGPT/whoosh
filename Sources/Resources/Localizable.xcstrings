    },
    "One letter each, never a chord. Watch the stage, then try them: J and K move, E marks done, H reminds you later.": {
      "comment": "FirstStart (Sources/Features/FirstStart/FirstStartWords.swift). machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ét bogstav hver, aldrig en kombination. Se på scenen, og prøv dem så: J og K flytter, E markerer som færdig, H minder dig om det senere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Je ein Buchstabe, nie eine Tastenkombination. Sehen Sie sich die Bühne an und probieren Sie es aus: J und K bewegen, E markiert als erledigt, H erinnert Sie später."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One letter each, never a chord. Watch the stage, then try them: J and K move, E marks done, H reminds you later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una letra cada una, nunca una combinación. Mira el escenario y pruébalas: J y K se mueven, E marca como hecho, H te lo recuerda más tarde."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yksi kirjain kullekin, ei koskaan yhdistelmää. Katso esitystä ja kokeile sitten: J ja K siirtävät, E merkitsee tehdyksi, H muistuttaa myöhemmin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une lettre chacune, jamais un raccourci à plusieurs touches. Regardez la scène, puis essayez : J et K déplacent, E marque comme terminé, H vous le rappelle plus tard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una lettera ciascuno, mai una combinazione. Guarda la scena, poi provali: J e K si spostano, E segna come fatto, H te lo ricorda più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どれも1文字だけで、組み合わせは不要です。ステージを見てから試してください：JとKで移動、Eで完了、Hであとで通知します。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Én bokstav hver, aldri en kombinasjon. Se på scenen og prøv dem: J og K flytter, E markerer som ferdig, H minner deg senere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk één letter, nooit een combinatie. Kijk naar het podium en probeer ze: J en K verplaatsen, E markeert als klaar, H herinnert je er later aan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy to jedna litera, nigdy skrót z kilku klawiszy. Obejrzyj scenę, a potem wypróbuj: J i K przesuwają, E oznacza jako zrobione, H przypomni później."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma letra cada, nunca uma combinação. Veja o palco e experimente: J e K movem, E marca como feito, H lembra você mais tarde."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En bokstav var, aldrig en kombination. Titta på scenen och prova: J och K flyttar, E markerar som klart, H påminner dig senare."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个按键只需一个字母，无需组合键。先看看舞台，再试一试：J 和 K 移动，E 标记为完成，H 稍后提醒你。"
          }
        }
      }
    },
    "One model runs on this Mac for Ask, Writer and summaries. It downloads once and nothing else leaves your Mac.": {
      "comment": "Sources/Features/OnDeviceAI/OnDeviceWords.swift:6. machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Én model kører på denne Mac til Spørg, Skribent og resuméer. Den hentes én gang, og intet andet forlader din Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Modell läuft auf diesem Mac für Fragen, Schreibhilfe und Zusammenfassungen. Es wird einmal geladen und sonst verlässt nichts Ihren Mac."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One model runs on this Mac for Ask, Writer and summaries. It downloads once and nothing else leaves your Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un modelo se ejecuta en este Mac para Ask, Writer y los resúmenes. Se descarga una vez y nada más sale de tu Mac."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yksi malli toimii tällä Macilla Kysy-, Kirjoitus- ja yhteenvetotoiminnoissa. Se ladataan kerran, eikä mikään muu poistu Macistasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un modèle tourne sur ce Mac pour Demander, l’Assistant d’écriture et les résumés. Il se télécharge une fois et rien d’autre ne quitte votre Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un modello gira su questo Mac per Ask, Writer e i riepiloghi. Si scarica una volta sola e nient’altro lascia il tuo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask、作成、要約で使う1つのモデルがこのMac上で動作します。ダウンロードは1回だけで、それ以外のデータがMacの外に出ることはありません。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Én modell kjører på denne Macen for Spør, Skribent og sammendrag. Den lastes ned én gang, og ingenting annet forlater Macen din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén model draait op deze Mac voor Vraag, Schrijfhulp en samenvattingen. Het wordt één keer gedownload en niets anders verlaat je Mac."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden model działa na tym Macu dla Zapytaj, Pisarza i podsumowań. Pobiera się raz i nic poza tym nie opuszcza Twojego Maca."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um modelo roda neste Mac para o Ask, o Writer e os resumos. Ele é baixado uma vez e nada mais sai do seu Mac."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En modell körs på den här Macen för Fråga, Skribent och sammanfattningar. Den laddas ned en gång och inget annat lämnar din Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个模型在这台 Mac 上运行，用于“询问”、写作和摘要。它只下载一次，其他任何内容都不会离开你的 Mac。"
          }
        }
      }
