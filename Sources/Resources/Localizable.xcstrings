        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żadna wiadomość nie pasuje jeszcze do tych słów. Folder pozostanie pusty, dopóki jakaś nie pasuje."
          }
        },
        "pt": {
          "stringUnit": {
