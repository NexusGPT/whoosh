    "entra-guide.s03.hint": {
      "comment": "Sources/Features/EntraGuide (entra-guide lane). machine-translated, owner review pending.",
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan du ikke se den? Skriv »App registrations« i søgefeltet øverst."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht zu sehen? Geben Sie oben in der Suchleiste „App registrations“ ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can’t see it? Type “App registrations” in the search bar at the top."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿No lo ves? Escribe «App registrations» en la barra de búsqueda de arriba."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkö näe sitä? Kirjoita ylhäällä hakukenttään ”App registrations”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne le voyez pas ? Tapez « App registrations » dans la barre de recherche en haut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non lo vedi? Scrivi «App registrations» nella barra di ricerca in alto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見つからない場合は、上の検索バーに「App registrations」と入力します。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ser du den ikke? Skriv «App registrations» i søkefeltet øverst."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zie je het niet? Typ “App registrations” in de zoekbalk bovenaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie widzisz tego? Wpisz „App registrations” w pasku wyszukiwania u góry."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não encontra? Digite “App registrations” na barra de busca no alto."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ser du den inte? Skriv ”App registrations” i sökfältet högst upp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看不到？在顶部搜索栏输入“App registrations”。"
          }
        }
      }
    },
