    "Let an app such as Claude Desktop search your mail through Whoosh. It sees nothing until you allow it, and every search asks you first.": {
      "comment": "McpNotesMac (Sources/Features/McpNotesMac/McpWords.swift:7). machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lad en app som Claude Desktop søge i din mail via Whoosh. Den ser intet, før du tillader det, og hver søgning spørger dig først."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lassen Sie eine App wie Claude Desktop Ihre Mail über Whoosh durchsuchen. Sie sieht nichts, bis Sie es erlauben, und jede Suche fragt zuerst bei Ihnen nach."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let an app such as Claude Desktop search your mail through Whoosh. It sees nothing until you allow it, and every search asks you first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja que una app como Claude Desktop busque en tu correo a través de Whoosh. No ve nada hasta que la permitas, y cada búsqueda te lo pregunta antes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anna sovelluksen, kuten Claude Desktop, hakea postistasi Whooshin kautta. Se ei näe mitään ennen kuin sallit sen, ja jokainen haku kysyy ensin lupaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez une app comme Claude Desktop chercher dans vos e-mails via Whoosh. Elle ne voit rien tant que vous ne l’autorisez pas, et chaque recherche vous est soumise."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia che un'app come Claude Desktop cerchi nella tua posta tramite Whoosh. Non vede nulla finché non la consenti, e ogni ricerca ti chiede prima conferma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Desktopなどのアプリから、Whoosh経由でメールを検索できます。許可するまで何も見えず、検索のたびに確認します。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "La en app som Claude Desktop søke i e-posten din via Whoosh. Den ser ingenting før du tillater det, og hvert søk spør deg først."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat een app zoals Claude Desktop je mail doorzoeken via Whoosh. Ze ziet niets tot je het toestaat, en elke zoekopdracht vraagt eerst om je toestemming."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozwól aplikacji, np. Claude Desktop, przeszukiwać Twoją pocztę przez Whoosh. Nic nie widzi, dopóki jej na to nie zezwolisz, a każde wyszukiwanie wymaga Twojej zgody."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe um app como o Claude Desktop pesquisar seus e-mails pelo Whoosh. Ele não vê nada até você permitir, e toda busca pergunta antes."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låt en app som Claude Desktop söka i din e-post via Whoosh. Den ser inget förrän du tillåter det, och varje sökning frågar dig först."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让Claude Desktop等App通过Whoosh搜索你的邮件。未经你允许,它看不到任何内容,且每次搜索都会先征求你的同意。"
          }
        }
      }
    },
