            "value": "Ny mail leveres ikke længere straks til denne Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue E-Mails werden nicht mehr sofort an diesen Mac gesendet."
          }
        },
        "en": {
