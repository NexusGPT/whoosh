    "The local database refused the imported mail. What was stored stays; try again.": {
      "comment": "WelcomeMac (Sources/Features/WelcomeMac/ImportWords.swift). machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den lokale database afviste den importerede mail. Det, der er gemt, bliver; prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die lokale Datenbank hat die importierten E-Mails abgelehnt. Was gespeichert wurde, bleibt; versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The local database refused the imported mail. What was stored stays; try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La base de datos local rechazó el correo importado. Lo guardado se queda; inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paikallinen tietokanta hylkäsi tuodun postin. Jo tallennettu säilyy; yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La base de données locale a refusé le courrier importé. Ce qui a été enregistré reste ; réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il database locale ha rifiutato la posta importata. Ciò che è stato salvato resta; riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルデータベースが読み込んだメールを受け付けませんでした。保存済みのメールはそのまま残ります。もう一度お試しください。"
