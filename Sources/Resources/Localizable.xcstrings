    "entra-guide.s26.hint": {
      "comment": "Sources/Features/EntraGuide (entraguide-r3 lane, A98). machine-translated, owner review pending.",
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke ejeren af registreringen. Administratoren åbner linket nedenfor og sætter flueben ved »Giv samtykke på vegne af din organisation«, eller går til Entra › App registrations › Whoosh › API permissions › Grant admin consent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht der Inhaber der Registrierung. Der Administrator öffnet den Link unten und setzt das Häkchen bei „Im Namen Ihrer Organisation zustimmen“ oder geht zu Entra › App registrations › Whoosh › API permissions › Grant admin consent."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not the registration's owner. The admin opens the link below and ticks “Consent on behalf of your organisation”, or goes to Entra › App registrations › Whoosh › API permissions › Grant admin consent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No el propietario del registro. El administrador abre el enlace de abajo y marca «Dar consentimiento en nombre de su organización», o va a Entra › App registrations › Whoosh › API permissions › Grant admin consent."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei rekisteröinnin omistaja. Järjestelmänvalvoja avaa alla olevan linkin ja valitsee ”Hyväksy organisaationne puolesta” tai siirtyy kohtaan Entra › App registrations › Whoosh › API permissions › Grant admin consent."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas le propriétaire de l'enregistrement. L'administrateur ouvre le lien ci-dessous et coche « Consentir au nom de votre organisation », ou va à Entra › App registrations › Whoosh › API permissions › Grant admin consent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non il proprietario della registrazione. L'amministratore apre il link qui sotto e seleziona «Fornisci il consenso per conto dell'organizzazione», oppure va su Entra › App registrations › Whoosh › API permissions › Grant admin consent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "登録の所有者ではありません。管理者は下のリンクを開いて「組織を代表して同意する」にチェックを入れるか、Entra › App registrations › Whoosh › API permissions › Grant admin consent を開きます。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke eieren av registreringen. Administratoren åpner lenken under og krysser av for «Samtykk på vegne av organisasjonen din», eller går til Entra › App registrations › Whoosh › API permissions › Grant admin consent."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet de eigenaar van de registratie. De beheerder opent de link hieronder en vinkt “Toestemming geven namens uw organisatie” aan, of gaat naar Entra › App registrations › Whoosh › API permissions › Grant admin consent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie właściciel rejestracji. Administrator otwiera poniższy link i zaznacza „Wyraź zgodę w imieniu organizacji”, albo przechodzi do Entra › App registrations › Whoosh › API permissions › Grant admin consent."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não o proprietário do registo. O administrador abre a ligação abaixo e marca “Consentir em nome da sua organização”, ou vai a Entra › App registrations › Whoosh › API permissions › Grant admin consent."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inte registreringens ägare. Administratören öppnar länken nedan och bockar i ”Godkänn för din organisation” eller går till Entra › App registrations › Whoosh › API permissions › Grant admin consent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不是注册的所有者。管理员打开下方链接并勾选“代表你的组织同意”，或前往 Entra › App registrations › Whoosh › API permissions › Grant admin consent。"
          }
        }
      }
    },
    "entra-guide.s26.say": {
      "comment": "Sources/Features/EntraGuide (entraguide-r3 lane, A98). machine-translated, owner review pending.",
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik på »Grant admin consent«, og klik derefter på »Yes«. Denne godkendelse gives af organisationens administrator (%@)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicken Sie auf „Grant admin consent“, dann auf „Yes“. Diese Genehmigung erteilt der Administrator der Organisation (%@)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click Grant admin consent, then Yes. The organisation's admin gives this approval (%@)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en «Grant admin consent» y después en «Yes». Esta aprobación la da el administrador de la organización (%@)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napsauta kohtaa ”Grant admin consent” ja sitten kohtaa ”Yes”. Tämän hyväksynnän antaa organisaation järjestelmänvalvoja (%@)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur « Grant admin consent », puis sur « Yes ». C'est l'administrateur de l'organisation qui donne cette approbation (%@)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic su «Grant admin consent», poi su «Yes». Questa approvazione la dà l'amministratore dell'organizzazione (%@)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「Grant admin consent」をクリックし、続けて「Yes」をクリックします。この承認は組織の管理者が行います（%@）。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Klikk på «Grant admin consent», og deretter på «Yes». Denne godkjenningen gis av administratoren i organisasjonen (%@)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik op “Grant admin consent” en daarna op “Yes”. Deze goedkeuring geeft de beheerder van de organisatie (%@)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij „Grant admin consent”, a potem „Yes”. Tę zgodę wyraża administrator organizacji (%@)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique em “Grant admin consent” e depois em “Yes”. Esta aprovação é dada pelo administrador da organização (%@)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicka på ”Grant admin consent” och sedan på ”Yes”. Det här godkännandet ges av organisationens administratör (%@)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按“Grant admin consent”，然后点按“Yes”。这项批准由该组织的管理员给出（%@）。"
          }
        }
      }
    },
    "entra-guide.s27.cap": {
      "comment": "Sources/Features/EntraGuide (entra-guide lane). machine-translated, owner review pending.",
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Færdig: et grønt flueben på hver linje"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fertig: ein grünes Häkchen in jeder Zeile"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done: a green tick on every line"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Listo: una marca verde en cada línea"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valmis: vihreä merkki jokaisella rivillä"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminé : une coche verte sur chaque ligne"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fatto: un segno di spunta verde su ogni riga"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了: すべての行に緑のチェック"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferdig: et grønt hakemerke på hver linje"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klaar: een groen vinkje op elke regel"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gotowe: zielony znaczek w każdym wierszu"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pronto: um visto verde em cada linha"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klart: en grön bock på varje rad"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成：每一行都有绿色勾号"
          }
        }
      }
    },
    "entra-guide.s27.say": {
      "comment": "Sources/Features/EntraGuide (entra-guide lane). machine-translated, owner review pending.",
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når hver linje har et grønt flueben, indsæt app-ID’et nedenfor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn jede Zeile ein grünes Häkchen hat, fügen Sie unten die App-ID ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When every line has a green tick, paste the app ID below."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando cada línea tenga una marca verde, pega abajo el ID de app."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun jokaisella rivillä on vihreä merkki, liitä sovellustunnus alle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand chaque ligne a une coche verte, collez l’ID d’app ci-dessous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ogni riga ha un segno di spunta verde, incolla qui sotto l’ID app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての行に緑のチェックが付いたら、下にアプリIDを貼り付けます。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når hver linje har et grønt hakemerke, limer du inn app-ID-en under."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als elke regel een groen vinkje heeft, plak je hieronder de app-ID."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy każdy wiersz ma zielony znaczek, wklej poniżej ID aplikacji."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando cada linha tiver um visto verde, cole o ID de app abaixo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När varje rad har en grön bock klistrar du in app-ID:t nedan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每一行都有绿色勾号后，在下方粘贴应用 ID。"
          }
        }
      }
    },
