    "%@'s mail server asked to try later. Whoosh tries again by itself.": {
      "comment": "QuickReply (Sources/Features/QuickReply/ThreadCardParts.swift): the outgoing card while the engine retries a send the server answered with a try-later code (4xx). %@ = the account's name. machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@s mailserver bad om at prøve senere. Whoosh prøver igen af sig selv."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mailserver von %@ bat darum, es später zu versuchen. Whoosh versucht es von selbst erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@'s mail server asked to try later. Whoosh tries again by itself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor de correo de %@ pidió intentarlo más tarde. Whoosh lo intenta de nuevo por sí solo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilin %@ postipalvelin pyysi yrittämään myöhemmin. Whoosh yrittää uudelleen itse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur de messagerie de %@ a demandé de réessayer plus tard. Whoosh réessaie tout seul."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server di posta di %@ ha chiesto di riprovare più tardi. Whoosh riprova da solo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ のメールサーバーが後でもう一度試すよう求めました。Whoosh が自動で再試行します。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "E-postserveren til %@ ba om å prøve senere. Whoosh prøver igjen av seg selv."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De mailserver van %@ vroeg om het later te proberen. Whoosh probeert het vanzelf opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer poczty konta %@ poprosił o ponowienie później. Whoosh ponowi próbę sam."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor de email de %@ pediu para tentar mais tarde. O Whoosh tenta de novo sozinho."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "E-postservern för %@ bad om ett nytt försök senare. Whoosh försöker igen av sig självt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的邮件服务器要求稍后再试。Whoosh 会自动重试。"
          }
