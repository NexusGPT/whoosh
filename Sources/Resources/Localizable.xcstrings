          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pęk kluczy tego Maca odmówił zapisania identyfikatora. Nic nie wysłano. Szczegóły pokazują słowa pęku kluczy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
