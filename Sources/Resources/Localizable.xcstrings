          "stringUnit": {
            "state": "translated",
            "value": "Napisz, co zmienić: „krócej”, „bez ceny”…"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Diga o que mudar: “mais curto”, “sem o preço”…"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Säg vad som ska ändras: ”kortare”, ”utan priset”…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说明要修改的内容：“更短”“不要价格”…"
          }
        }
      }
    },
    "Say where the other messages go before you turn the exit filter on": {
      "comment": "Sources/Features/LabelsContactsMac (round 3, the labelling flow). machine-translated, owner review pending. fr as on the board docs/design/boards/labels-flow-r1/v4.html.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Angiv, hvor de øvrige beskeder skal hen, før du slår udgangsfilteret til"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sagen Sie, wohin die übrigen Nachrichten kommen, bevor Sie den Ausgangsfilter einschalten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Say where the other messages go before you turn the exit filter on"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Di adónde van los demás mensajes antes de activar el filtro de salida"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kerro, minne muut viestit menevät, ennen kuin otat poistosuodattimen käyttöön"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dites où vont les autres"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica dove vanno gli altri messaggi prima di attivare il filtro di uscita"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "出口フィルタをオンにする前に、それ以外のメッセージの行き先を指定してください"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Angi hvor de andre meldingene går før du slår på utgangsfilteret"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeg waar de overige berichten heen gaan voordat je het uitgangsfilter aanzet"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiedz, dokąd trafiają pozostałe wiadomości, zanim włączysz filtr wyjścia"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Diga para onde vão as outras mensagens antes de ativar o filtro de saída"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange vart de övriga meddelandena går innan du slår på utgångsfiltret"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启出口过滤器之前,请先说明其余邮件放到哪里"
          }
        }
      }
    },
    "Say yes to the access Whoosh asks for.": {
      "comment": "WelcomeMac (Sources/Features/WelcomeMac/WelcomeRoutes.swift:55). machine-translated, owner review pending.",
