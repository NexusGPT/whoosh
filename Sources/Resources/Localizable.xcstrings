    "The AI judged %d mails and was sure of none: its best was %d %%, and it files from %d %%.": {
      "comment": "LabelFlowModel.swift AiRefusal.words (engine code ai_under_trust on label/<id>/flow/ai_refusal): judged, best percent, trust percent. Written for the fix-aisort finding F6; owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "AI’en vurderede %d mails og var ikke sikker på nogen: dens bedste var %d %%, og den sorterer fra %d %%."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die KI hat %d Mails beurteilt und war sich bei keiner sicher: ihr bester Wert war %d %%, sie sortiert ab %d %%."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The AI judged %d mails and was sure of none: its best was %d %%, and it files from %d %%."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La IA evaluó %d correos y no estuvo segura de ninguno: su mejor valor fue %d %%, y clasifica a partir de %d %%."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekoäly arvioi %d viestiä eikä ollut varma yhdestäkään: sen paras oli %d %%, ja se lajittelee %d %%:sta alkaen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’IA a jugé %d e-mails et n’était sûre d’aucun : son meilleur score était %d %%, et elle classe à partir de %d %%."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’IA ha valutato %d email e non era sicura di nessuna: il suo valore migliore era %d %%, e classifica da %d %%."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AI は %d 通のメールを判定しましたが、確信できたものはありませんでした。最高は %d %% で、%d %% 以上で振り分けます。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "KI-en vurderte %d e-poster og var ikke sikker på noen: det beste var %d %%, og den sorterer fra %d %%."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De AI beoordeelde %d mails en was van geen enkele zeker: het beste was %d %%, en hij sorteert vanaf %d %%."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "AI oceniła %d wiadomości i nie była pewna żadnej: najlepszy wynik to %d %%, a sortuje od %d %%."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A IA avaliou %d e-mails e não teve certeza de nenhum: o melhor foi %d %%, e ela classifica a partir de %d %%."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "AI:n bedömde %d mejl och var inte säker på något: det bästa var %d %%, och den sorterar från %d %%."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 判断了 %d 封邮件，没有一封有把握：最高为 %d %%，达到 %d %% 才归类。"
          }
        }
      }
    },
    "Sorting mail into labels needs Apple Intelligence: turn it on in System Settings, then Apple Intelligence and Siri.": {
      "comment": "ai_refusal code ai_needs_apple (LabelFlowModel.swift refusalDoor): Apple's on-device model judges the label AI step and Apple Intelligence is off. Names as Apple shows them (System Settings, Apple Intelligence & Siri); written for the fix-aisort finding F7, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sortering af mail i etiketter kræver Apple Intelligence: slå det til i Systemindstillinger under Apple Intelligence og Siri."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Sortieren in Labels braucht Apple Intelligence: Schalte es in den Systemeinstellungen unter „Apple Intelligence & Siri“ ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorting mail into labels needs Apple Intelligence: turn it on in System Settings, then Apple Intelligence and Siri."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para clasificar el correo en etiquetas se necesita Apple Intelligence: actívalo en Ajustes del Sistema, en Apple Intelligence y Siri."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Postin lajittelu tunnisteisiin vaatii Apple Intelligencen: ota se käyttöön Järjestelmäasetuksissa kohdassa Apple Intelligence ja Siri."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tri du courrier dans les libellés nécessite Apple Intelligence : activez-le dans Réglages Système, puis Apple Intelligence et Siri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per smistare la posta nelle etichette serve Apple Intelligence: attivalo in Impostazioni di Sistema, in Apple Intelligence e Siri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ラベルへのメールの振り分けには Apple Intelligence が必要です。システム設定の「Apple Intelligence と Siri」でオンにしてください。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sortering av e-post i etiketter krever Apple Intelligence: slå det på i Systeminnstillinger under Apple Intelligence og Siri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail in labels sorteren vereist Apple Intelligence: zet het aan in Systeeminstellingen, bij Apple Intelligence en Siri."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sortowanie poczty w etykiety wymaga Apple Intelligence: włącz je w Ustawieniach systemowych, w sekcji Apple Intelligence i Siri."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordenar o e-mail em etiquetas requer o Apple Intelligence: ative-o em Ajustes do Sistema, em Apple Intelligence e Siri."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att sortera e-post i etiketter kräver Apple Intelligence: slå på det i Systeminställningar under Apple Intelligence och Siri."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将邮件归入标签需要 Apple Intelligence：请在“系统设置”的“Apple Intelligence 与 Siri”中打开。"
          }
        }
      }
    },
