        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jev nie ma klucza: dodaj go w Ustawieniach, Decyzje."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Jev não tem chave: adicione-a em Definições, Decisões."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jev har ingen nyckel: lägg till den i Inställningar, Beslut."
