    "Whoosh writes a draft as soon as a message calls for one. Nothing is sent without you.": {
      "comment": "SettingsRepliesMac (docs/lanes/settingsreplies-mac.md), joined by settings-integrate. machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoosh skriver et udkast, så snart en besked kalder på et. Intet sendes uden dig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoosh schreibt einen Entwurf, sobald eine Nachricht einen verdient. Ohne Sie wird nichts gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoosh writes a draft as soon as a message calls for one. Nothing is sent without you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoosh escribe un borrador en cuanto un mensaje lo pide. Nada se envía sin ti."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoosh kirjoittaa luonnoksen heti, kun viesti sitä vaatii. Mitään ei lähetetä ilman sinua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoosh écrit un brouillon dès qu’un message le mérite. Rien n’est envoyé sans vous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoosh scrive una bozza appena un messaggio lo richiede. Niente viene inviato senza di te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージに返信が必要になると、Whooshがすぐに下書きを書きます。あなたの確認なしには何も送信されません。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoosh skriver et utkast så snart en melding trenger det. Ingenting sendes uten deg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoosh schrijft een concept zodra een bericht erom vraagt. Zonder jou wordt niets verstuurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoosh pisze szkic, gdy tylko wiadomość tego wymaga. Nic nie jest wysyłane bez Ciebie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Whoosh escreve um rascunho assim que uma mensagem pede. Nada é enviado sem você."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoosh skriver ett utkast så snart ett meddelande kräver det. Inget skickas utan dig."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "邮件需要回复时，Whoosh 会立即写好草稿。没有你的确认，什么都不会发送。"
          }
        }
      }
    },
