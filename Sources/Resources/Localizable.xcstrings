    "Paste a key. Whoosh asks the provider which models the key opens, then lists them.": {
      "comment": "SettingsAIMac (Sources/Features/SettingsAIMac/AIWords.swift:10). machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indsæt en nøgle. Whoosh spørger udbyderen, hvilke modeller nøglen åbner, og viser dem så."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie einen Schlüssel ein. Whoosh fragt den Anbieter, welche Modelle der Schlüssel öffnet, und listet sie dann auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste a key. Whoosh asks the provider which models the key opens, then lists them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pega una clave. Whoosh pregunta al proveedor qué modelos abre la clave y los lista."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liitä avain. Whoosh kysyy palveluntarjoajalta, mitkä mallit avain avaa, ja listaa ne."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collez une clé. Whoosh demande au fournisseur quels modèles la clé ouvre, puis les liste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incolla una chiave. Whoosh chiede al provider quali modelli apre la chiave, poi li elenca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーを貼り付けてください。Whooshがプロバイダにキーで使えるモデルを問い合わせ、一覧表示します。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lim inn en nøkkel. Whoosh spør leverandøren hvilke modeller nøkkelen åpner, og lister dem opp."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plak een sleutel. Whoosh vraagt de aanbieder welke modellen de sleutel opent en toont ze dan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wklej klucz. Whoosh zapyta dostawcę, które modele otwiera ten klucz, i je wyświetli."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cole uma chave. O Whoosh pergunta ao provedor quais modelos a chave abre e depois os lista."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klistra in en nyckel. Whoosh frågar leverantören vilka modeller nyckeln öppnar och listar dem sedan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴密钥。Whoosh会向提供商查询该密钥可使用哪些模型,然后列出。"
          }
        }
      }
    },
