            "value": "%lld mensajes más antiguos aún no están ordenados. Repetir ordena los siguientes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld vanhempaa viestiä on vielä lajittelematta. Uudelleenajo lajittelee seuraavat."
          }
