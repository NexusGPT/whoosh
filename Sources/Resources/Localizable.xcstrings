    "Speech recognition has not been allowed yet, so voice notes and videos are searched by name only.": {
      "comment": "Sources/Features/AttachmentIndex/OnDeviceSpeech.swift:34. machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Talegenkendelse er endnu ikke tilladt, så talememoer og videoer søges kun på navn."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Spracherkennung wurde noch nicht erlaubt, daher werden Sprachnotizen und Videos nur nach Namen durchsucht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech recognition has not been allowed yet, so voice notes and videos are searched by name only."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reconocimiento de voz aún no se ha permitido, así que las notas de voz y los vídeos se buscan solo por nombre."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puheentunnistusta ei ole vielä sallittu, joten äänimuistiinpanoista ja videoista haetaan vain nimen mukaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La reconnaissance vocale n’a pas encore été autorisée : les notes vocales et les vidéos sont cherchées par nom uniquement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il riconoscimento vocale non è ancora stato consentito, quindi note vocali e video si cercano solo per nome."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声認識がまだ許可されていないため、ボイスメモとビデオは名前でのみ検索されます。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Talegjenkjenning er ikke tillatt ennå, så talememoer og videoer søkes bare på navn."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spraakherkenning is nog niet toegestaan, dus spraaknotities en video’s worden alleen op naam doorzocht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpoznawanie mowy nie zostało jeszcze dozwolone, więc notatki głosowe i wideo są przeszukiwane tylko po nazwie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O reconhecimento de fala ainda não foi permitido, então notas de voz e vídeos são pesquisados só pelo nome."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Taligenkänning har inte tillåtits ännu, så röstmemon och videor söks bara på namn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未允许语音识别，因此语音备忘录和视频仅按名称搜索。"
          }
        }
      }
    },
    "Speech recognition is off for Whoosh. Allow it in System Settings, Privacy & Security, Speech Recognition, to search inside voice notes and videos.": {
      "comment": "Sources/Features/AttachmentIndex/OnDeviceSpeech.swift:32. machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Talegenkendelse er slået fra for Whoosh. Tillad den i Systemindstillinger, Anonymitet og sikkerhed, Talegenkendelse, for at søge i talememoer og videoer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Spracherkennung ist für Whoosh ausgeschaltet. Erlaube sie in Systemeinstellungen, Datenschutz & Sicherheit, Spracherkennung, um Sprachnotizen und Videos zu durchsuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech recognition is off for Whoosh. Allow it in System Settings, Privacy & Security, Speech Recognition, to search inside voice notes and videos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reconocimiento de voz está desactivado para Whoosh. Permítelo en Ajustes del Sistema, Privacidad y seguridad, Reconocimiento de voz, para buscar dentro de notas de voz y vídeos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puheentunnistus on pois päältä Whooshilta. Salli se Järjestelmäasetuksissa kohdassa Yksityisyys ja turvallisuus, Puheentunnistus, jotta äänimuistiinpanoista ja videoista voi hakea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La reconnaissance vocale est désactivée pour Whoosh. Autorisez-la dans Réglages Système, Confidentialité et sécurité, Reconnaissance vocale, pour chercher dans les notes vocales et les vidéos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il riconoscimento vocale è disattivato per Whoosh. Consentilo in Impostazioni di Sistema, Privacy e sicurezza, Riconoscimento vocale, per cercare nelle note vocali e nei video."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Whooshの音声認識がオフです。ボイスメモやビデオの中を検索するには、システム設定の「プライバシーとセキュリティ」>「音声認識」で許可してください。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Talegjenkjenning er slått av for Whoosh. Tillat den i Systeminnstillinger, Personvern og sikkerhet, Talegjenkjenning, for å søke i talememoer og videoer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spraakherkenning staat uit voor Whoosh. Sta het toe in Systeeminstellingen, Privacy en beveiliging, Spraakherkenning, om in spraaknotities en video’s te zoeken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpoznawanie mowy jest wyłączone dla Whoosh. Zezwól na nie w Ustawieniach systemowych, Prywatność i ochrona, Rozpoznawanie mowy, aby przeszukiwać notatki głosowe i wideo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O reconhecimento de fala está desativado para o Whoosh. Permita em Ajustes do Sistema, Privacidade e Segurança, Reconhecimento de Fala, para pesquisar dentro de notas de voz e vídeos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Taligenkänning är avstängd för Whoosh. Tillåt den i Systeminställningar, Integritet och säkerhet, Taligenkänning, för att söka i röstmemon och videor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已为 Whoosh 关闭语音识别。请在“系统设置”>“隐私与安全性”>“语音识别”中允许，以便搜索语音备忘录和视频内部。"
          }
        }
      }
    },
    "Speech recognition is restricted on this Mac, so voice notes and videos are searched by name only.": {
