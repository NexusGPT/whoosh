    "Which label fits this email? Pick any node of the tree, or propose a new child.": {
      "comment": "SettingsAIMac (Sources/Features/SettingsAIMac/AISettingsStore.swift:147). machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvilken etiket passer til denne mail? Vælg en vilkårlig node i træet, eller foreslå en ny underordnet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welches Label passt zu dieser E-Mail? Wählen Sie einen Knoten im Baum oder schlagen Sie ein neues Unterlabel vor."
