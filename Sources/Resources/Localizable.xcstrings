    "One page per thing Whoosh decides. Each page is one list: the first entry that answers wins.": {
      "comment": "SettingsAIMac (Sources/Features/SettingsAIMac/AIWords.swift:30). machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Én side for hver ting, Whoosh afgør. Hver side er én liste: den første post, der svarer, vinder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Seite für alles, was Whoosh entscheidet. Jede Seite ist eine Liste: Der erste Eintrag, der antwortet, gilt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One page per thing Whoosh decides. Each page is one list: the first entry that answers wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una página por cada cosa que decide Whoosh. Cada página es una lista: gana la primera entrada que responde."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yksi sivu jokaista Whooshin päättämää asiaa kohden. Jokainen sivu on yksi lista: ensimmäinen vastaava merkintä voittaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une page par chose que Whoosh décide. Chaque page est une liste : la première entrée qui répond l’emporte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una pagina per ogni cosa che Whoosh decide. Ogni pagina è un elenco: vince la prima voce che risponde."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Whooshが判断する項目ごとに1ページあります。各ページは1つのリストで、最初に答えたエントリが採用されます。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Én side for hver ting Whoosh avgjør. Hver side er én liste: den første oppføringen som svarer, vinner."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén pagina per ding dat Whoosh beslist. Elke pagina is één lijst: het eerste item dat antwoordt wint."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedna strona na każdą rzecz, o której decyduje Whoosh. Każda strona to jedna lista: wygrywa pierwszy wpis, który odpowie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma página para cada coisa que o Whoosh decide. Cada página é uma lista: vale a primeira entrada que responde."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En sida för varje sak som Whoosh avgör. Varje sida är en lista: den första posten som svarar vinner."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoosh所决定的每件事各占一页。每页是一个列表:第一个作出回答的条目生效。"
          }
        }
      }
    },
