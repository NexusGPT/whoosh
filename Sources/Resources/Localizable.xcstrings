          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique no nome de um remetente em qualquer mensagem para ver tudo o que ele enviou."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
