    "On your Mac, open Whoosh and choose Move accounts to iPhone. Your accounts arrive here, with no password to type.": {
      "comment": "WelcomePhone (Sources/Features/WelcomePhone/WelcomeSteps.swift:26). machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn Whoosh på din Mac, og vælg Flyt konti til iPhone. Dine konti kommer hertil uden at skulle skrive en adgangskode."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie Whoosh auf Ihrem Mac und wählen Sie Accounts auf das iPhone übertragen. Ihre Accounts kommen hier an, ohne dass Sie ein Passwort eingeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On your Mac, open Whoosh and choose Move accounts to iPhone. Your accounts arrive here, with no password to type."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En tu Mac, abre Whoosh y elige Mover cuentas al iPhone. Tus cuentas llegan aquí, sin escribir ninguna contraseña."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa Whoosh Macillasi ja valitse Siirrä tilit iPhoneen. Tilisi siirtyvät tänne ilman salasanan kirjoittamista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur votre Mac, ouvrez Whoosh et choisissez Déplacer les comptes vers l’iPhone. Vos comptes arrivent ici, sans mot de passe à saisir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sul tuo Mac, apri Whoosh e scegli Sposta gli account su iPhone. I tuoi account arrivano qui, senza digitare alcuna password."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MacでWhooshを開き、「アカウントをiPhoneに移す」を選びます。アカウントがここに届き、パスワードの入力は不要です。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne Whoosh på Macen din og velg Flytt kontoer til iPhone. Kontoene dine kommer hit, uten at du skriver passord."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Whoosh op je Mac en kies Verplaats accounts naar iPhone. Je accounts komen hier aan, zonder wachtwoord om in te typen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na Macu otwórz Whoosh i wybierz Przenieś konta na iPhone’a. Twoje konta pojawią się tutaj, bez wpisywania hasła."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "No seu Mac, abra o Whoosh e escolha Mover contas para o iPhone. Suas contas chegam aqui, sem digitar nenhuma senha."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna Whoosh på din Mac och välj Flytta konton till iPhone. Dina konton kommer hit, utan att du skriver något lösenord."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Mac 上打开 Whoosh，选择“将账户移到iPhone”。你的账户会直接传到这里，无需输入密码。"
          }
        }
      }
    },
