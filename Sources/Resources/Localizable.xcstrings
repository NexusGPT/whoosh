      }
    },
    "Jev is not refitted: make a rule from these corrections instead.": {
      "comment": "SettingsAIMac (hid-ai round 4). machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Jev trænes ikke igen: lav i stedet en regel ud fra disse rettelser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jev wird nicht neu angepasst: Mach stattdessen aus diesen Korrekturen eine Regel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jev is not refitted: make a rule from these corrections instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Jev no se reajusta: crea una regla a partir de estas correcciones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeviä ei soviteta uudelleen: tee näistä korjauksista sääntö."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jev n’est pas réentraîné : créez plutôt une règle à partir de ces rectifications."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Jev non viene riadattato: crea invece una regola da queste correzioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Jev は再調整されません。代わりにこれらの修正からルールを作成してください。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Jev tilpasses ikke på nytt: lag heller en regel av disse rettelsene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jev wordt niet opnieuw afgestemd: maak in plaats daarvan een regel van deze correcties."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jev nie jest ponownie dopasowywany: utwórz zamiast tego regułę z tych poprawek."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Jev não é reajustado: crie antes uma regra a partir destas correções."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
