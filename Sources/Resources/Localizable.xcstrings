        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Jev のキーがありません。設定の「判断」で追加してください。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Jev har ingen nøkkel: legg den til i Innstillinger, Beslutninger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jev heeft geen sleutel: voeg die toe in Instellingen, Beslissingen."
