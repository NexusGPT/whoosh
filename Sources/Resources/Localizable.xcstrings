    "One switch per account. Mute one without touching the others.": {
      "comment": "SettingsGeneralMac (Sources/Features/SettingsGeneralMac/GeneralWords.swift:30). machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
