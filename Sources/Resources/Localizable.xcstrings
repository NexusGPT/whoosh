    "entra-guide.keychain": {
      "comment": "Sources/Features/EntraGuide (entra-guide lane). machine-translated, owner review pending.",
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det bliver i nøgleringen på denne Mac. Intet sendes andre steder hen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie bleibt im Schlüsselbund dieses Mac. Nichts wird anderswohin gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It stays in this Mac’s Keychain. Nothing is sent anywhere else."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se queda en el llavero de este Mac. No se envía nada a otro sitio."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pysyy tämän Macin avainnipussa. Mitään ei lähetetä muualle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il reste dans le trousseau de ce Mac. Rien n’est envoyé ailleurs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Resta nel Portachiavi di questo Mac. Non viene inviato altrove."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacのキーチェーンに保存されます。ほかには何も送信されません。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den blir i nøkkelringen på denne Macen. Ingenting sendes andre steder."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het blijft in de sleutelhanger van deze Mac. Er wordt niets naar een andere plek gestuurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostaje w Pęku kluczy tego Maca. Nic nie jest wysyłane gdzie indziej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele fica no chaveiro deste Mac. Nada é enviado para outro lugar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det stannar i nyckelringen på den här Macen. Inget skickas någon annanstans."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它会保存在这台 Mac 的钥匙串中。不会发送到其他任何地方。"
          }
        }
      }
    },
