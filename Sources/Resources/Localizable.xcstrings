    "Whoosh answers only over a connection on this Mac. Revoking an app ends its access at once.": {
      "comment": "McpNotesMac (Sources/Features/McpNotesMac/McpWords.swift:20). machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoosh svarer kun over en forbindelse på denne Mac. Hvis du trækker en apps adgang tilbage, ophører den med det samme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoosh antwortet nur über eine Verbindung auf diesem Mac. Das Widerrufen einer App beendet ihren Zugriff sofort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoosh answers only over a connection on this Mac. Revoking an app ends its access at once."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoosh responde solo por una conexión en este Mac. Revocar una app termina su acceso al instante."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoosh vastaa vain tämän Macin yhteyden kautta. Sovelluksen peruutus katkaisee sen pääsyn heti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoosh ne répond que via une connexion sur ce Mac. Révoquer une app met fin à son accès immédiatement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoosh risponde solo tramite una connessione su questo Mac. Revocare un'app ne termina subito l'accesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "WhooshはこのMac 上の接続にのみ応答します。アプリを取り消すと、そのアクセスは直ちに終了します。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoosh svarer bare over en tilkobling på denne Macen. Hvis du trekker tilbake en apps tilgang, stopper den umiddelbart."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoosh antwoordt alleen via een verbinding op deze Mac. Een app intrekken beëindigt de toegang meteen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoosh odpowiada tylko przez połączenie na tym Macu. Cofnięcie dostępu aplikacji kończy go natychmiast."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Whoosh responde só por uma conexão neste Mac. Revogar um app encerra o acesso na hora."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoosh svarar bara över en anslutning på den här Macen. Om du återkallar en app upphör dess åtkomst direkt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoosh只通过这台Mac上的连接应答。撤销某个App的授权会立即终止其访问。"
          }
        }
      }
    },
