    "Pick the keys you already know. Single keys only: nothing here needs a chord of three.": {
      "comment": "SettingsGeneralMac (Sources/Features/SettingsGeneralMac/GeneralWords.swift:16). machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg de taster, du allerede kender. Kun enkelte taster: intet her kræver en kombination af tre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie die Tasten, die Sie schon kennen. Nur einzelne Tasten: Hier braucht nichts eine Kombination aus dreien."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick the keys you already know. Single keys only: nothing here needs a chord of three."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige las teclas que ya conoces. Solo teclas sueltas: aquí nada necesita un acorde de tres."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse jo tuntemasi näppäimet. Vain yksittäisiä näppäimiä: mikään ei vaadi kolmen näppäimen yhdistelmää."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez les touches que vous connaissez déjà. Touches seules : rien ici n’exige un enchaînement de trois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli i tasti che già conosci. Solo tasti singoli: qui nulla richiede una combinazione di tre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでに使い慣れたキーを選んでください。単独のキーのみです。3つのキーの同時押しが必要なものはありません。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg tastene du allerede kan. Bare enkelttaster: ingenting her krever en kombinasjon av tre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies de toetsen die je al kent. Alleen losse toetsen: hier heb je geen combinatie van drie nodig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
