    "Hi,\n\nPlease confirm the delivery date and send me the signed quote.\n\nThank you": {
      "comment": "Sources/Features/ComposerMac/ComposerLibrary.swift:42. machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hej,\n\nBekræft venligst leveringsdatoen, og send mig det underskrevne tilbud.\n\nTak"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Guten Tag,\n\nbitte bestätigen Sie das Lieferdatum und senden Sie mir das unterschriebene Angebot.\n\nVielen Dank"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi,\n\nPlease confirm the delivery date and send me the signed quote.\n\nThank you"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hola:\n\nPor favor, confirma la fecha de entrega y envíame el presupuesto firmado.\n\nGracias"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hei,\n\nVoisitko vahvistaa toimituspäivän ja lähettää minulle allekirjoitetun tarjouksen.\n\nKiitos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bonjour,\n\nMerci de confirmer la date de livraison et de m’envoyer le devis signé.\n\nMerci"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciao,\n\nPer favore conferma la data di consegna e mandami il preventivo firmato.\n\nGrazie"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お世話になっております。\n\n納品日のご確認と、署名済みの見積書のご送付をお願いいたします。\n\nよろしくお願いいたします。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hei,\n\nBekreft leveringsdatoen og send meg det signerte tilbudet.\n\nTakk"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hallo,\n\nBevestig de leverdatum en stuur me de getekende offerte.\n\nBedankt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzień dobry,\n\nProszę o potwierdzenie terminu dostawy i przesłanie mi podpisanej oferty.\n\nDziękuję"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Olá,\n\nPor favor, confirme a data de entrega e me envie o orçamento assinado.\n\nObrigado"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hej,\n\nBekräfta leveransdatumet och skicka mig den signerade offerten.\n\nTack"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您好，\n\n请确认送达日期，并将已签署的报价单发给我。\n\n谢谢"
          }
        }
      }
    },
