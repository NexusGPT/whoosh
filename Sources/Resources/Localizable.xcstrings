          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacのキーチェーンがIDの保存を拒否しました。何も送信されていません。詳細にキーチェーンのメッセージが表示されます。"
          }
        },
        "nb": {
          "stringUnit": {
