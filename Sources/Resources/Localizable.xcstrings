    "The model is off, so there is nothing to refit: choose Local in Settings, Decisions.": {
      "comment": "SettingsAIMac (hid-ai round 4). machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellen er slået fra, så der er intet at træne igen: vælg Lokal under Indstillinger, Beslutninger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Modell ist aus, es gibt nichts anzupassen: Wähle Lokal unter Einstellungen, Entscheidungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model is off, so there is nothing to refit: choose Local in Settings, Decisions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo está desactivado, así que no hay nada que reajustar: elige Local en Ajustes, Decisiones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Malli on pois päältä, joten sovitettavaa ei ole: valitse Paikallinen kohdasta Asetukset, Päätökset."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle est désactivé, il n’y a donc rien à réentraîner : choisissez Local dans Réglages, Décisions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello è spento, quindi non c’è nulla da riadattare: scegli Locale in Impostazioni, Decisioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルがオフのため、再調整するものはありません。設定の「判断」で「ローカル」を選んでください。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellen er av, så det er ingenting å tilpasse: velg Lokal under Innstillinger, Beslutninger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het model staat uit, dus er valt niets opnieuw af te stemmen: kies Lokaal in Instellingen, Beslissingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Model jest wyłączony, więc nie ma czego dopasowywać: wybierz Lokalny w Ustawieniach, Decyzje."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo está desligado, por isso não há nada a reajustar: escolha Local em Definições, Decisões."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellen är avstängd, så det finns inget att anpassa: välj Lokal under Inställningar, Beslut."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型已关闭，没有可重新调整的内容：请在设置的“决策”中选择“本地”。"
          }
        }
      }
    },
