    "Settles %@. The first entry that answers wins.": {
      "comment": "SettingsAIMac (Sources/Features/SettingsAIMac/AIWords.swift:67). machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
