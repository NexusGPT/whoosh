    "Emails that wait for a reply from me: a question, a request, a decision that someone is waiting for.": {
      "comment": "SettingsAIMac (hid-ai round 6). machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "E-mails, der venter på svar fra mig: et spørgsmål, en anmodning, en beslutning, som nogen venter på."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "E-Mails, die auf eine Antwort von mir warten: eine Frage, eine Bitte, eine Entscheidung, auf die jemand wartet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Emails that wait for a reply from me: a question, a request, a decision that someone is waiting for."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Correos que esperan una respuesta mía: una pregunta, una petición, una decisión que alguien espera."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sähköpostit, jotka odottavat vastaustani: kysymys, pyyntö tai päätös, jota joku odottaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les e-mails qui attendent une réponse de moi : une question, une demande, une décision que quelqu’un attend."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Email che aspettano una mia risposta: una domanda, una richiesta, una decisione che qualcuno attende."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "私の返信を待っているメール：質問、依頼、誰かが待っている決定。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "E-poster som venter på svar fra meg: et spørsmål, en forespørsel, en beslutning noen venter på."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "E-mails die op een antwoord van mij wachten: een vraag, een verzoek, een beslissing waar iemand op wacht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "E-maile czekające na moją odpowiedź: pytanie, prośba, decyzja, na którą ktoś czeka."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "E-mails que esperam uma resposta minha: uma pergunta, um pedido, uma decisão que alguém aguarda."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mejl som väntar på svar från mig: en fråga, en begäran, ett beslut som någon väntar på."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待我回复的邮件：一个问题、一个请求、一个有人在等待的决定。"
          }
        }
      }
    },
