        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You ask for a draft in a thread, whenever you want."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pides un borrador en un hilo cuando quieras."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pyydät luonnoksen ketjussa milloin haluat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous demandez un brouillon dans un fil, quand vous le voulez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedi una bozza in una conversazione, quando vuoi."
          }
