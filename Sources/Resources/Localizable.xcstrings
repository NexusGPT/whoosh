    "Scan a code on your iPhone. Your accounts go across on this Wi-Fi. Your passwords never leave this Mac.": {
      "comment": "SettingsAccountsMac (Sources/Features/SettingsAccountsMac/AccountsWords.swift:18). machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan en kode på din iPhone. Dine konti flyttes over på dette Wi-Fi. Dine adgangskoder forlader aldrig denne Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannen Sie einen Code auf Ihrem iPhone. Ihre Accounts gehen über dieses Wi-Fi hinüber. Ihre Passwörter verlassen diesen Mac nie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan a code on your iPhone. Your accounts go across on this Wi-Fi. Your passwords never leave this Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanea un código en tu iPhone. Tus cuentas pasan por este Wi-Fi. Tus contraseñas nunca salen de este Mac."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Skannaa koodi iPhonellasi. Tilisi siirtyvät tämän Wi-Fi-verkon kautta. Salasanasi eivät koskaan poistu tältä Macilta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannez un code sur votre iPhone. Vos comptes passent par ce Wi-Fi. Vos mots de passe ne quittent jamais ce Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scansiona un codice sul tuo iPhone. I tuoi account passano su questo Wi-Fi. Le tue password non lasciano mai questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneでコードをスキャンしてください。アカウントはこのWi-Fiで転送されます。パスワードはこのMacの外に出ません。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skann en kode på iPhone. Kontoene dine flyttes over på dette Wi-Fi-nettet. Passordene dine forlater aldri denne Macen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan een code op je iPhone. Je accounts gaan over via dit Wi-Fi. Je wachtwoorden verlaten deze Mac nooit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeskanuj kod na iPhonie. Konta przejdą przez tę sieć Wi-Fi. Hasła nigdy nie opuszczą tego Maca."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escaneie um código no seu iPhone. Suas contas passam por este Wi-Fi. Suas senhas nunca saem deste Mac."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skanna en kod på din iPhone. Dina konton förs över på det här Wi-Fi. Dina lösenord lämnar aldrig den här Macen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在iPhone上扫描代码。你的账户会通过这个Wi-Fi转移。你的密码绝不会离开这台Mac。"
          }
        }
      }
    },
