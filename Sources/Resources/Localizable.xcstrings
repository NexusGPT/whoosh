    "Files stay in the pop-out window. Remove them to put the reply back in the thread.": {
      "comment": "Sources/Features/ComposerMac/ComposerWords.swift:164. machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Filer bliver i vinduet. Fjern dem for at sætte svaret tilbage i tråden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien bleiben im Fenster. Entferne sie, um die Antwort zurück in den Verlauf zu legen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files stay in the pop-out window. Remove them to put the reply back in the thread."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos se quedan en la ventana. Quítalos para devolver la respuesta al hilo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiedostot jäävät ikkunaan. Poista ne, jotta vastaus voidaan palauttaa ketjuun."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers restent dans la fenêtre. Retirez-les pour remettre la réponse dans le fil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file restano nella finestra. Rimuovili per rimettere la risposta nella conversazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルはウインドウに残ります。返信をスレッドに戻すには、ファイルを削除してください。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Filer blir i vinduet. Fjern dem for å sette svaret tilbake i tråden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestanden blijven in het venster. Verwijder ze om het antwoord terug in het gesprek te zetten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pliki zostają w oknie. Usuń je, aby przenieść odpowiedź z powrotem do wątku."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os ficheiros ficam na janela. Remova-os para pôr a resposta de volta na conversa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Filerna stannar i fönstret. Ta bort dem för att lägga tillbaka svaret i tråden."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件会留在此窗口。移除文件后才能把回复放回会话。"
          }
        }
      }
    },
