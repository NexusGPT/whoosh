    "entra-guide.s08.hint": {
      "comment": "Sources/Features/EntraGuide (entra-guide lane). machine-translated, owner review pending.",
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser Microsoft en rød besked, så indsæt adressen igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt Microsoft eine rote Meldung, fügen Sie die Adresse erneut ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If Microsoft shows a red message, paste the address again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si Microsoft muestra un mensaje en rojo, pega la dirección otra vez."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jos Microsoft näyttää punaisen viestin, liitä osoite uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si Microsoft affiche un message rouge, collez à nouveau l’adresse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se Microsoft mostra un messaggio rosso, incolla di nuovo l’indirizzo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Microsoftに赤いメッセージが出たら、もう一度アドレスを貼り付けます。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser Microsoft en rød melding, limer du inn adressen på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont Microsoft een rood bericht, plak het adres dan opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli Microsoft pokaże czerwony komunikat, wklej adres jeszcze raz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se a Microsoft mostrar uma mensagem vermelha, cole o endereço de novo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visar Microsoft ett rött meddelande, klistra in adressen igen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果 Microsoft 显示红色提示，请再粘贴一次地址。"
          }
        }
      }
    },
    "entra-guide.s08.say": {
      "comment": "Sources/Features/EntraGuide (entra-guide lane). machine-translated, owner review pending.",
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indsæt omdirigeringsadressen i feltet ved siden af."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie die Weiterleitungsadresse in das Feld daneben ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste the redirect address in the box next to it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pega la dirección de redirección en el campo de al lado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liitä uudelleenohjausosoite viereiseen kenttään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collez l’adresse de redirection dans le champ à côté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incolla l’indirizzo di reindirizzamento nel campo accanto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "隣の欄にリダイレクトアドレスを貼り付けます。"
          }
        },
        "nb": {
          "stringUnit": {
