    "Google sign-in is not open yet: Google's review of Whoosh is still pending. Use an app password for now.": {
      "comment": "SignIn (Sources/Features/SignIn/Engine/OAuthTypes.swift:99). machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Google-login er ikke åbent endnu: Googles gennemgang af Whoosh afventer stadig. Brug en app-adgangskode indtil videre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Google-Anmeldung ist noch nicht freigeschaltet: Die Prüfung von Whoosh durch Google läuft noch. Nutzen Sie vorerst ein App-Passwort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Google sign-in is not open yet: Google's review of Whoosh is still pending. Use an app password for now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El inicio de sesión de Google aún no está abierto: la revisión de Google sobre Whoosh sigue pendiente. Usa una contraseña de app por ahora."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Google-kirjautuminen ei ole vielä käytössä: Googlen Whoosh-tarkistus on kesken. Käytä toistaiseksi sovellussalasanaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion Google n’est pas encore ouverte : la validation de Whoosh par Google est en cours. Utilisez un mot de passe d’app pour l’instant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso con Google non è ancora aperto: la revisione di Google su Whoosh è ancora in corso. Per ora usa una password per app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Googleサインインはまだ利用できません。WhooshのGoogle審査が保留中です。当面はAppパスワードを使ってください。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Google-pålogging er ikke åpen ennå: Googles gjennomgang av Whoosh pågår fortsatt. Bruk et appassord inntil videre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inloggen met Google is nog niet open: de beoordeling van Whoosh door Google loopt nog. Gebruik voorlopig een app-wachtwoord."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Logowanie przez Google jeszcze nie działa: weryfikacja Whoosh przez Google trwa. Na razie użyj hasła aplikacji."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O login com Google ainda não está aberto: a análise do Google sobre o Whoosh continua pendente. Por ora, use uma senha de app."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inloggning med Google är inte öppen än: Googles granskning av Whoosh pågår. Använd ett applösenord tills vidare."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Google登录暂未开放:Google对Whoosh的审核仍在进行中。目前请使用App专用密码。"
          }
        }
      }
    },
