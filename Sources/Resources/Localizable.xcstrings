    "The connection to %@'s mail server broke. Whoosh tries again by itself.": {
      "comment": "QuickReply (Sources/Features/QuickReply/ThreadCardParts.swift): a send the engine tries again by itself. machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forbindelsen til mailserveren for %@ blev afbrudt. Whoosh prøver igen af sig selv."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung zum Mailserver von %@ ist abgebrochen. Whoosh versucht es von selbst erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection to %@'s mail server broke. Whoosh tries again by itself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conexión con el servidor de correo de %@ se cortó. Whoosh lo intenta de nuevo por sí solo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhteys tilin %@ sähköpostipalvelimeen katkesi. Whoosh yrittää itse uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion au serveur de messagerie de %@ a été coupée. Whoosh réessaie tout seul."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La connessione al server di posta di %@ si è interrotta. Whoosh riprova da solo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ のメールサーバーとの接続が切れました。Whoosh が自動で再試行します。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Forbindelsen til e-postserveren til %@ ble brutt. Whoosh prøver igjen av seg selv."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De verbinding met de mailserver van %@ is verbroken. Whoosh probeert het vanzelf opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połączenie z serwerem poczty konta %@ zostało przerwane. Whoosh spróbuje ponownie sam."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A ligação ao servidor de correio de %@ foi interrompida. O Whoosh tenta de novo sozinho."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anslutningen till e-postservern för %@ bröts. Whoosh försöker igen av sig själv."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与 %@ 的邮件服务器的连接已中断。Whoosh 会自动重试。"
          }
        }
      }
    },
