    "It may have left the inbox. Go back to the list.": {
      "comment": "ThreadPhone (Sources/Features/ThreadPhone/ThreadPhoneWords.swift:28). machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den kan have forladt indbakken. Gå tilbage til listen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie ist möglicherweise nicht mehr im Eingang. Gehen Sie zurück zur Liste."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It may have left the inbox. Go back to the list."
