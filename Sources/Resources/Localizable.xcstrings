    "entra-guide.s06.hint": {
      "comment": "Sources/Features/EntraGuide (entra-guide lane). machine-translated, owner review pending.",
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun til din egen organisation virker »Accounts in this organizational directory only« også."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur für die eigene Organisation geht auch „Accounts in this organizational directory only“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For your own organisation only, “Accounts in this organizational directory only” also works."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo para tu propia organización, también sirve «Accounts in this organizational directory only»."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain oman organisaatiosi käyttöön sopii myös ”Accounts in this organizational directory only”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour votre seule organisation, « Accounts in this organizational directory only » convient aussi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo per la tua organizzazione va bene anche «Accounts in this organizational directory only»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の組織だけなら、「Accounts in this organizational directory only」でも使えます。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare for din egen organisasjon fungerer også «Accounts in this organizational directory only»."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen voor je eigen organisatie werkt ook “Accounts in this organizational directory only”."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko dla własnej organizacji pasuje też „Accounts in this organizational directory only”."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Só para a sua organização, “Accounts in this organizational directory only” também serve."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara för din egen organisation fungerar även ”Accounts in this organizational directory only”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果只供你自己的组织使用，“Accounts in this organizational directory only”也可以。"
          }
        }
      }
    },
    "entra-guide.s06.say": {
      "comment": "Sources/Features/EntraGuide (entra-guide lane). machine-translated, owner review pending.",
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn listen under »Supported account types«, og vælg linjen nedenfor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie unter „Supported account types“ die Liste, und wählen Sie die unten gezeigte Zeile."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the list under Supported account types and pick the line shown below."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la lista de «Supported account types» y elige la línea que se muestra abajo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa luettelo kohdassa ”Supported account types” ja valitse alla näkyvä rivi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez la liste sous « Supported account types » et choisissez la ligne montrée ci-dessous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri l’elenco sotto «Supported account types» e scegli la riga mostrata qui sotto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「Supported account types」の下のリストを開き、下に示す行を選びます。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne listen under «Supported account types», og velg linjen som vises under."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open de lijst onder “Supported account types” en kies de regel hieronder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz listę pod „Supported account types” i wybierz wiersz pokazany poniżej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra a lista em “Supported account types” e escolha a linha mostrada abaixo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna listan under ”Supported account types” och välj raden som visas nedan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开“Supported account types”下的列表，选取下方显示的那一行。"
          }
        }
      }
    },
