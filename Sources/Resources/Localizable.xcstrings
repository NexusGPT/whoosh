          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den lokala databasen avvisade den importerade e-posten. Det som sparats finns kvar; försök igen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地数据库拒绝了导入的邮件。已保存的内容会保留；请重试。"
          }
        }
      }
    },
