    "What Whoosh may read again to write. Everything stays on this Mac.": {
      "comment": "SettingsRepliesMac (docs/lanes/settingsreplies-mac.md), joined by settings-integrate. machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvad Whoosh må læse igen for at skrive. Alt bliver på denne Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was Whoosh zum Schreiben erneut lesen darf. Alles bleibt auf diesem Mac."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What Whoosh may read again to write. Everything stays on this Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que Whoosh puede volver a leer para escribir. Todo se queda en este Mac."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitä Whoosh saa lukea uudelleen kirjoittaakseen. Kaikki pysyy tällä Macilla."
          }
        },
        "fr": {
          "stringUnit": {
