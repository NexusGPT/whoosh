    "Type what you remember, not the exact words. Whoosh searches every account and every year at once.": {
      "comment": "FirstStart (Sources/Features/FirstStart/FirstStartWords.swift). machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv det, du husker, ikke de præcise ord. Whoosh søger i alle konti og alle år på én gang."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie ein, woran Sie sich erinnern, nicht den genauen Wortlaut. Whoosh durchsucht alle Accounts und alle Jahre auf einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type what you remember, not the exact words. Whoosh searches every account and every year at once."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe lo que recuerdes, no las palabras exactas. Whoosh busca en todas las cuentas y en todos los años a la vez."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjoita, mitä muistat, ei tarkkoja sanoja. Whoosh hakee kaikista tileistä ja kaikilta vuosilta kerralla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez ce dont vous vous souvenez, pas les mots exacts. Whoosh cherche dans tous les comptes et toutes les années à la fois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi ciò che ricordi, non le parole esatte. Whoosh cerca in tutti gli account e in tutti gli anni insieme."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "覚えていることを入力してください。正確な言葉でなくて構いません。Whooshはすべてのアカウントとすべての年を一度に検索します。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv det du husker, ikke de nøyaktige ordene. Whoosh søker i alle kontoer og alle år samtidig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Typ wat je je herinnert, niet de exacte woorden. Whoosh doorzoekt alle accounts en alle jaren tegelijk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz to, co pamiętasz, a nie dokładne słowa. Whoosh przeszukuje wszystkie konta i wszystkie lata naraz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite o que você lembra, não as palavras exatas. O Whoosh pesquisa todas as contas e todos os anos de uma vez."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv det du minns, inte de exakta orden. Whoosh söker i alla konton och alla år på en gång."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入你记得的内容，不必是准确的字词。Whoosh 会同时搜索所有账户和所有年份。"
          }
        }
      }
    },
