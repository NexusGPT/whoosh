    "Answers cite the messages they come from. Nothing changes until you approve it.": {
      "comment": "AskMac (Sources/Features/AskMac/AskWords.swift:8). machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Svar henviser til de beskeder, de bygger på. Intet ændres, før du godkender det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Antworten nennen die Nachrichten, aus denen sie stammen. Nichts ändert sich ohne Ihre Freigabe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answers cite the messages they come from. Nothing changes until you approve it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las respuestas citan los mensajes de origen. Nada cambia hasta que lo apruebes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vastaukset viittaavat viesteihin, joista ne tulevat. Mikään ei muutu ennen kuin hyväksyt sen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réponses citent les messages dont elles viennent. Rien ne change sans votre accord."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le risposte citano i messaggi da cui provengono. Nulla cambia finché non approvi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回答には引用元のメッセージが付きます。承認するまで何も変更されません。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Svar viser til meldingene de bygger på. Ingenting endres før du godkjenner det."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Antwoorden noemen de berichten waar ze vandaan komen. Er verandert niets zonder je goedkeuring."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpowiedzi wskazują wiadomości, z których pochodzą. Nic się nie zmieni bez Twojej zgody."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As respostas citam as mensagens de origem. Nada muda até você aprovar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaren hänvisar till meddelandena de bygger på. Inget ändras förrän du godkänner."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回答会引用其来源邮件。未经你批准,不会有任何更改。"
          }
        }
      }
    },
