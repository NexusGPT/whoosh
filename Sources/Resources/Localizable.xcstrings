    "New mail drops into the notch. Off, mail only reaches you as notifications.": {
      "comment": "SettingsGeneralMac (Sources/Features/SettingsGeneralMac/GeneralWords.swift, notch switch). machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ny mail falder ned i notchen. Slået fra får du kun notifikationer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Mails erscheinen im Notch. Ausgeschaltet kommen sie nur als Mitteilungen an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New mail drops into the notch. Off, mail only reaches you as notifications."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El correo nuevo cae en el notch. Desactivado, solo llega como notificaciones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Uusi posti putoaa loveen. Pois päältä posti tulee vain ilmoituksina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nouveaux mails tombent dans le notch. Désactivé, ils n’arrivent qu’en notifications."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La nuova posta scende nel notch. Se è disattivato, arriva solo come notifiche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新着メールはノッチに表示されます。オフにすると通知のみになります。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ny e-post faller ned i notchen. Av får du bare varsler."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieuwe mail valt in de notch. Uit komt mail alleen als melding binnen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nowa poczta spada do notcha. Po wyłączeniu dociera tylko jako powiadomienia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O correio novo cai no notch. Desativado, só chega como notificações."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nytt mejl faller ned i notchen. Avstängt får du bara aviseringar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新邮件会从刘海处弹出。关闭后，邮件只以通知形式送达。"
          }
        }
      }
    },
    "New mail is no longer pushed to this Mac.": {
      "comment": "MacShell and AddAccount (Sources/Features/MacShell/MacSyncStatus.swift): the sentence for a sync status code (sync-words). machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
