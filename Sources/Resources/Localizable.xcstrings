          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld mensagens mais antigas ainda não foram ordenadas. Executar de novo ordena as seguintes."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld äldre meddelanden är inte sorterade än. Köra igen sorterar nästa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还有 %lld 封较早的邮件未分类。重新运行会分类接下来的邮件。"
