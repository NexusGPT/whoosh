    "Sent for each message: from, to, cc, subject, the start of the body, whether it has a list header. Never attachments, never the whole thread.": {
      "comment": "SettingsAIMac (Sources/Features/SettingsAIMac/AIWords.swift:38). machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendes for hver besked: fra, til, cc, emne, begyndelsen af teksten og om den har en listeheader. Aldrig vedhæftninger, aldrig hele tråden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für jede Nachricht gesendet: Absender, Empfänger, Cc, Betreff, der Anfang des Textes, ob sie einen Listen-Header hat. Nie Anhänge, nie die ganze Konversation."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sent for each message: from, to, cc, subject, the start of the body, whether it has a list header. Never attachments, never the whole thread."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se envía por cada mensaje: remitente, destinatarios, cc, asunto, el inicio del cuerpo y si tiene cabecera de lista. Nunca adjuntos, nunca el hilo completo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokaisesta viestistä lähetetään: lähettäjä, vastaanottaja, kopio, aihe, rungon alku ja onko siinä listaotsake. Ei koskaan liitteitä, ei koko keskustelua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyé pour chaque message : de, à, cc, objet, le début du corps, la présence d’un en-tête de liste. Jamais les pièces jointes, jamais tout le fil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inviato per ogni messaggio: da, a, cc, oggetto, l’inizio del corpo, se ha un’intestazione di lista. Mai allegati, mai l’intera conversazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージごとに送信される内容: 差出人、宛先、Cc、件名、本文の冒頭、リストヘッダの有無。添付ファイルやスレッド全体は送信されません。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendes for hver melding: fra, til, kopi, emne, starten av teksten og om den har en listeoverskrift. Aldri vedlegg, aldri hele tråden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor elk bericht verstuurd: van, aan, cc, onderwerp, het begin van de tekst, of het een lijstheader heeft. Nooit bijlagen, nooit de hele conversatie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysyłane dla każdej wiadomości: od, do, kopia, temat, początek treści, informacja, czy ma nagłówek listy. Nigdy załączniki ani cały wątek."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviado para cada mensagem: de, para, cc, assunto, o início do corpo, se tem cabeçalho de lista. Nunca anexos, nunca a conversa inteira."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skickas för varje meddelande: från, till, kopia, ämne, början av texten och om det har en listrubrik. Aldrig bilagor, aldrig hela tråden."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每封邮件会发送:发件人、收件人、抄送、主题、正文开头,以及是否有列表头。绝不发送附件,也绝不发送整个对话。"
          }
        }
      }
    },
