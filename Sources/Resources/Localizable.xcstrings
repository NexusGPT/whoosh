    "Or drop one here. It is cut to a square.": {
      "comment": "SettingsAccountsMac (Sources/Features/SettingsAccountsMac/AccountsWords.swift:38). machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Eller slip et her. Det beskæres til en firkant."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oder legen Sie hier eines ab. Es wird quadratisch zugeschnitten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Or drop one here. It is cut to a square."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "O suelta una aquí. Se recorta en cuadrado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tai pudota sellainen tähän. Se rajataan neliöksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ou déposez-en une ici. Elle est recadrée en carré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppure trascinane una qui. Viene ritagliata a quadrato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "または、ここにドロップしてください。正方形に切り抜かれます。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Eller slipp ett her. Det beskjæres til en firkant."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Of zet er hier een neer. Hij wordt vierkant bijgesneden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Albo upuść obraz tutaj. Zostanie przycięty do kwadratu."
