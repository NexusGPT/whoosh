    "These rules run first. The AI reads only the mails they pick.": {
      "comment": "LabelsContactsMac (Sources/Features/LabelsContactsMac/LabelFlowCards.swift:125). machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These rules run first. The AI reads only the mails they pick."
          }
        },
        "fr": {
          "stringUnit": {
