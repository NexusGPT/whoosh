    "Apple Intelligence sorts your labels on this Mac; Laya decides the rest. Nothing leaves.": {
      "comment": "SettingsAIMac (hid-ai round 12). machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence sorterer dine etiketter på denne Mac; Laya afgør resten. Intet forlader den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence sortiert deine Etiketten auf diesem Mac; Laya entscheidet den Rest. Nichts verlässt ihn."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence sorts your labels on this Mac; Laya decides the rest. Nothing leaves."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ordena tus etiquetas en este Mac; Laya decide el resto. Nada sale de él."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence lajittelee tunnisteesi tällä Macilla; Laya päättää loput. Mitään ei lähde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence trie vos étiquettes sur ce Mac ; Laya décide du reste. Rien ne sort."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ordina le tue etichette su questo Mac; Laya decide il resto. Nulla esce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence がこの Mac 上でラベルを振り分け、残りは Laya が判断します。何も外に出ません。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence sorterer etikettene dine på denne Macen; Laya avgjør resten. Ingenting forlater den."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence sorteert je labels op deze Mac; Laya beslist de rest. Er gaat niets naar buiten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence sortuje twoje etykiety na tym Macu; Laya decyduje o reszcie. Nic go nie opuszcza."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Apple Intelligence ordena as suas etiquetas neste Mac; o Laya decide o resto. Nada sai dele."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence sorterar dina etiketter på den här Macen; Laya avgör resten. Inget lämnar den."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence 在这台 Mac 上整理你的标签；其余由 Laya 决定。什么都不会离开。"
          }
        }
      }
    },
