          "stringUnit": {
            "state": "translated",
            "value": "アプリ全体がすぐにこの言語になります。メインウインドウ、クイック返信、設定、サイドバー。再起動は不要です。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hele appen snakker dette språket med en gang: hovedvinduet, hurtigsvar, Innstillinger og sidepanelet. Ingen omstart."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De hele app spreekt meteen deze taal: het hoofdvenster, snel antwoord, Instellingen en de zijbalk. Geen herstart."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cała aplikacja od razu mówi w tym języku: okno główne, szybka odpowiedź, Ustawienia i pasek boczny. Bez restartu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A app inteira fala este idioma de imediato: a janela principal, a resposta rápida, as Definições e a barra lateral. Sem reiniciar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hela appen talar detta språk direkt: huvudfönstret, snabbsvaret, Inställningar och sidofältet. Ingen omstart."
          }
        },
