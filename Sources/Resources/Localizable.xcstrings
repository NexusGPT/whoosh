    "%@ Set up on-device AI again to download a fresh copy.": {
      "comment": "Sources/Features/OnDeviceAI/Core/MlxBackend.swift:31. machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Opsæt AI på enheden igen for at hente en ny kopi."
          }
        },
        "de": {
