    "This phone cannot reach your Mac yet. Check that both are online, then scan again.": {
      "comment": "WelcomePhone (Sources/Features/WelcomePhone/WelcomePhoneCode.swift:32). machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne telefon kan ikke nå din Mac endnu. Tjek, at begge er online, og scan derefter igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Telefon kann Ihren Mac noch nicht erreichen. Prüfen Sie, ob beide online sind, und scannen Sie dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone cannot reach your Mac yet. Check that both are online, then scan again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este teléfono aún no puede conectar con tu Mac. Comprueba que ambos estén en línea y vuelve a escanear."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä puhelin ei vielä tavoita Maciasi. Tarkista, että molemmat ovat verkossa, ja skannaa sitten uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce téléphone ne peut pas encore joindre votre Mac. Vérifiez que les deux sont en ligne, puis scannez à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo telefono non riesce ancora a raggiungere il tuo Mac. Controlla che entrambi siano online, poi scansiona di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この電話はまだMacに接続できません。両方がオンラインか確認して、もう一度スキャンしてください。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne telefonen når ikke Macen din ennå. Sjekk at begge er på nett, og skann deretter igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze telefoon kan je Mac nog niet bereiken. Controleer of beide online zijn en scan dan opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten telefon nie może jeszcze połączyć się z Twoim Makiem. Sprawdź, czy oba urządzenia są online, i zeskanuj ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este telefone ainda não consegue alcançar seu Mac. Verifique se os dois estão online e escaneie de novo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här telefonen når inte din Mac än. Kontrollera att båda är online och skanna sedan igen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这部手机暂时无法连接到你的 Mac。请确认两者都已联网，然后重新扫描。"
          }
        }
      }
    },
    "This prompt is about %@ tokens and the on-device model reads at most %@ (prompt and answer together). Shorten it and try again.": {
      "comment": "Sources/Features/OnDeviceAI/Core/LocalModelAvailability.swift:27. machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne prompt er cirka %@ tokens, og modellen på enheden læser højst %@ (prompt og svar tilsammen). Gør den kortere, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Prompt hat etwa %@ Tokens und das Modell auf dem Gerät liest höchstens %@ (Prompt und Antwort zusammen). Kürzen Sie ihn und versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This prompt is about %@ tokens and the on-device model reads at most %@ (prompt and answer together). Shorten it and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este prompt tiene unos %@ tokens y el modelo del dispositivo lee como máximo %@ (consulta y respuesta juntas). Acórtalo e inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä kehote on noin %@ tokenia, ja laitteen malli lukee enintään %@ (kehote ja vastaus yhteensä). Lyhennä sitä ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce prompt fait environ %@ tokens et le modèle sur l’appareil en lit au plus %@ (prompt et réponse ensemble). Raccourcissez-le et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo prompt è di circa %@ token e il modello sul dispositivo legge al massimo %@ (richiesta e risposta insieme). Accorcialo e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプロンプトは約%@トークンですが、オンデバイスモデルが読み取れるのは最大%@です(プロンプトと回答の合計)。短くしてもう一度お試しください。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne prompten er omtrent %@ tokens, og modellen på enheten leser høyst %@ (prompt og svar til sammen). Gjør den kortere og prøv igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze prompt is ongeveer %@ tokens en het model op het apparaat leest er hooguit %@ (prompt en antwoord samen). Kort hem in en probeer opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten prompt ma około %@ tokenów, a model na urządzeniu czyta najwyżej %@ (prompt i odpowiedź razem). Skróć go i spróbuj ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este prompt tem cerca de %@ tokens e o modelo no dispositivo lê no máximo %@ (pergunta e resposta juntas). Encurte-o e tente de novo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här prompten är ungefär %@ tokens och modellen på enheten läser högst %@ (prompt och svar tillsammans). Korta ned den och försök igen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此提示约有 %@ 个 token，而设备端模型最多可读取 %@（提示与回答合计）。请缩短后重试。"
          }
        }
      }
    },
