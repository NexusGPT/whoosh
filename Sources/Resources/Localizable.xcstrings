    "May do nothing yet. Pick what it may do.": {
      "comment": "SettingsAIMac (Sources/Features/SettingsAIMac/AIWords.swift:63). machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan måske ikke noget endnu. Vælg, hvad den må."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tut vielleicht noch nichts. Wählen Sie, was es tun darf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May do nothing yet. Pick what it may do."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede que aún no haga nada. Elige qué puede hacer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei vielä tee mitään. Valitse, mitä se saa tehdä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne fait rien pour l’instant. Choisissez ce qu’il peut faire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Può non fare ancora nulla. Scegli cosa può fare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ何もしない場合があります。許可する操作を選んでください。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan hende den ikke gjør noe ennå. Velg hva den får gjøre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doet misschien nog niets. Kies wat het mag doen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na razie może nic nie robić. Wybierz, co wolno."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode não fazer nada ainda. Escolha o que ele pode fazer."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan inte göra något än. Välj vad den får göra."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前可能什么也不做。请选取它可执行的操作。"
          }
        }
      }
