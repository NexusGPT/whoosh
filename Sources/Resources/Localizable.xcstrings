      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Etiketten gælder kun %@ og kan derfor ikke passe til mail fra %@. Skift Gælder for, eller fjern reglen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Label gilt nur für %@ und kann daher keine Mails von %@ erfassen. Ändern Sie „Gilt für“ oder entfernen Sie die Regel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The label applies to %@ only, so it cannot match %@ mail. Change Applies to, or remove the rule."
