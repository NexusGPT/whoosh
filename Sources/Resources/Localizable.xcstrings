    "I can label these %lld messages as %@. Nothing changes until you approve.": {
      "comment": "AskMac (Sources/Features/AskMac/AskWords.swift:32). machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
