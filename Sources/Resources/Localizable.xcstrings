        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld komen in %@, %lld verlaat, %lld blijven. Niet nu behoudt de huidige indeling."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do %2$@ dołącza: %1$lld, odchodzi: %3$lld, zostaje: %4$lld. “Nie teraz” zachowuje dzisiejsze zaszeregowanie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld entram em %@, %lld saem e %lld ficam. Agora não mantém a classificação atual."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld går med i %@, %lld lämnar, %lld stannar. Inte nu behåller dagens sortering."
          }
        },
