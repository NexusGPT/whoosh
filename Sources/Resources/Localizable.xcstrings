    "Does this email ask me, personally, to answer or to do something?": {
      "comment": "SettingsAIMac (Sources/Features/SettingsAIMac/DecisionCatalog.swift:42). machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Beder denne mail mig personligt om at svare eller gøre noget?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bittet diese E-Mail mich persönlich, zu antworten oder etwas zu tun?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Does this email ask me, personally, to answer or to do something?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Este correo me pide a mí, personalmente, que responda o que haga algo?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pyytääkö tämä viesti minua henkilökohtaisesti vastaamaan tai tekemään jotain?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet e-mail me demande-t-il, à moi personnellement, de répondre ou d’agir ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa email chiede a me, personalmente, di rispondere o di fare qualcosa?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このメールは、私個人に返信や対応を求めていますか?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ber denne e-posten meg personlig om å svare eller gjøre noe?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraagt deze e-mail mij persoonlijk om te antwoorden of iets te doen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy ten e-mail prosi mnie osobiście o odpowiedź lub o zrobienie czegoś?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este e-mail pede que eu, pessoalmente, responda ou faça algo?"
          }
        },
