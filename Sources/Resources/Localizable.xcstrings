            "state": "translated",
            "value": "Jev n’a pas de clé : ajoutez-la dans Réglages, Décisions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Jev non ha una chiave: aggiungetela in Impostazioni, Decisioni."
