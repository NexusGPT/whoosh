    "entra-guide.slot-placeholder": {
      "comment": "Sources/Features/EntraGuide (entra-guide lane). machine-translated, owner review pending.",
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indsæt det her. Whoosh gemmer det til sidste trin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier einfügen. Whoosh hält sie für den letzten Schritt bereit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste it here. Whoosh keeps it for the last step."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pégalo aquí. Whoosh lo guarda para el último paso."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liitä se tähän. Whoosh säilyttää sen viimeistä vaihetta varten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collez-le ici. Whoosh le garde pour la dernière étape."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incollalo qui. Whoosh lo conserva per l’ultimo passo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここに貼り付けます。Whooshが最後のステップまで保管します。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lim den inn her. Whoosh tar vare på den til siste trinn."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plak het hier. Whoosh bewaart het voor de laatste stap."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wklej je tutaj. Whoosh zachowa je do ostatniego kroku."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cole aqui. O Whoosh guarda o ID até o último passo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klistra in det här. Whoosh sparar det till sista steget."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此粘贴。Whoosh 会保留到最后一步。"
          }
        }
      }
    },
