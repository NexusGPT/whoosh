    "%@ is not allowed to label mail. Switch agent, or allow labels for it in Settings: AI providers, speech and agents.": {
      "comment": "AskMac (Sources/Features/AskMac/AskWords.swift:25). machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ må ikke sætte etiketter på mails. Skift agent, eller tillad etiketter i Indstillinger: AI-udbydere, tale og agenter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ darf keine E-Mails labeln. Wechseln Sie den Agenten oder erlauben Sie Labels in den Einstellungen: KI-Anbieter, Sprache und Agenten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is not allowed to label mail. Switch agent, or allow labels for it in Settings: AI providers, speech and agents."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no tiene permiso para etiquetar el correo. Cambia de agente o permítelo en Ajustes: proveedores de IA, voz y agentes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ei saa merkitä viestejä tunnisteilla. Vaihda agenttia tai salli tunnisteet sille kohdassa Asetukset: tekoälypalvelut, puhe ja agentit."
