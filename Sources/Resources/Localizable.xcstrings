    "add-account.engine.oauth_consent_path_page": {
      "comment": "AddAccount (A97): admin path 1, on Microsoft's own page. The quoted labels are Microsoft's own English words. machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg “Have an admin account? Sign in with that account” på Microsofts side, log ind som administrator, sæt flueben ved “Consent on behalf of your organization”, og vælg derefter Accept."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie auf der Seite von Microsoft „Have an admin account? Sign in with that account“, melden Sie sich als Administrator an, setzen Sie den Haken bei „Consent on behalf of your organization“ und wählen Sie Accept."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On Microsoft's page, choose “Have an admin account? Sign in with that account”, sign in as the admin, tick “Consent on behalf of your organization”, then Accept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la página de Microsoft, elige «Have an admin account? Sign in with that account», inicia sesión como administrador, marca «Consent on behalf of your organization» y pulsa Accept."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse Microsoftin sivulla “Have an admin account? Sign in with that account”, kirjaudu sisään järjestelmänvalvojana, valitse “Consent on behalf of your organization” ja paina Accept."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur la page de Microsoft, choisissez « Have an admin account? Sign in with that account », connectez-vous en tant qu'administrateur, cochez « Consent on behalf of your organization », puis Accept."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nella pagina di Microsoft scegli «Have an admin account? Sign in with that account», accedi come amministratore, spunta «Consent on behalf of your organization» e premi Accept."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Microsoft のページで「Have an admin account? Sign in with that account」を選び、管理者としてサインインし、「Consent on behalf of your organization」にチェックを入れて Accept を押します。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg «Have an admin account? Sign in with that account» på Microsofts side, logg på som administrator, huk av for «Consent on behalf of your organization», og velg Accept."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies op de pagina van Microsoft “Have an admin account? Sign in with that account”, log in als beheerder, vink “Consent on behalf of your organization” aan en kies Accept."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na stronie Microsoft wybierz „Have an admin account? Sign in with that account”, zaloguj się jako administrator, zaznacz „Consent on behalf of your organization” i wybierz Accept."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Na página da Microsoft, escolha «Have an admin account? Sign in with that account», inicie sessão como administrador, marque «Consent on behalf of your organization» e clique em Accept."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj “Have an admin account? Sign in with that account” på Microsofts sida, logga in som administratör, bocka i “Consent on behalf of your organization” och välj Accept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Microsoft 的页面上选择“Have an admin account? Sign in with that account”，以管理员身份登录，勾选“Consent on behalf of your organization”，然后点按 Accept。"
          }
        }
      }
    },
    "add-account.engine.oauth_consent_required": {
      "comment": "AddAccount (AddAccountEngine.swift, A97): Microsoft says an admin must approve the app once. machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din organisations administrator skal godkende Whoosh én gang. Derefter kan du logge ind."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Administrator Ihrer Organisation muss Whoosh einmalig genehmigen. Danach können Sie sich anmelden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your organisation's admin must approve Whoosh once. Then you can sign in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El administrador de tu organización debe aprobar Whoosh una sola vez. Después podrás iniciar sesión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Organisaatiosi järjestelmänvalvojan on hyväksyttävä Whoosh kerran. Sen jälkeen voit kirjautua sisään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'administrateur de votre organisation doit approuver Whoosh une seule fois. Ensuite, vous pourrez vous connecter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'amministratore della tua organizzazione deve approvare Whoosh una sola volta. Poi potrai accedere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "組織の管理者が Whoosh を一度承認する必要があります。その後、サインインできます。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Administratoren i organisasjonen din må godkjenne Whoosh én gang. Deretter kan du logge på."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De beheerder van je organisatie moet Whoosh één keer goedkeuren. Daarna kun je inloggen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Administrator Twojej organizacji musi jednorazowo zatwierdzić Whoosh. Potem możesz się zalogować."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O administrador da sua organização tem de aprovar o Whoosh uma só vez. Depois, pode iniciar sessão."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din organisations administratör måste godkänna Whoosh en gång. Sedan kan du logga in."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您所在组织的管理员需要批准一次 Whoosh。之后即可登录。"
          }
        }
      }
    },
    "add-account.engine.oauth_keychain": {
      "comment": "AddAccount (AddAccountEngine.swift, round 5): the sentence for an engine refusal code. machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
