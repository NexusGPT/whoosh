        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@にはメールへのラベル付けが許可されていません。エージェントを切り替えるか、設定:AIプロバイダ、音声、エージェントで許可してください。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
