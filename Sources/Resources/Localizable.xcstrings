    "entra-guide.s10.say": {
      "comment": "Sources/Features/EntraGuide (entra-guide lane). machine-translated, owner review pending.",
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Microsoft åbner din nye app. Kontrollér, at »Overview« er valgt i menuen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Microsoft öffnet Ihre neue App. Prüfen Sie, ob im Menü „Overview“ gewählt ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Microsoft opens your new app. Check that Overview is selected in its menu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Microsoft abre tu nueva app. Comprueba que «Overview» esté seleccionado en el menú."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Microsoft avaa uuden sovelluksesi. Tarkista, että valikossa on valittuna ”Overview”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Microsoft ouvre votre nouvelle app. Vérifiez que « Overview » est sélectionné dans le menu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Microsoft apre la tua nuova app. Controlla che «Overview» sia selezionato nel menu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Microsoftが新しいアプリを開きます。メニューで「Overview」が選ばれていることを確認します。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Microsoft åpner den nye appen din. Sjekk at «Overview» er valgt i menyen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Microsoft opent je nieuwe app. Controleer of “Overview” in het menu is gekozen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Microsoft otworzy Twoją nową aplikację. Sprawdź, czy w menu wybrano „Overview”."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A Microsoft abre seu novo app. Confira se “Overview” está selecionado no menu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Microsoft öppnar din nya app. Kontrollera att ”Overview” är markerat i menyn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Microsoft 会打开你的新应用。请确认菜单中已选中“Overview”。"
          }
        }
      }
    },
    "entra-guide.s11.cap": {
      "comment": "Sources/Features/EntraGuide (entra-guide lane). machine-translated, owner review pending.",
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Peg på ID’et, og klik på kopiikonet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf die ID zeigen, dann auf das Kopiersymbol klicken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Point at the ID, then click the copy icon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Señala el ID y haz clic en el icono de copiar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Osoita tunnusta ja napsauta kopiointikuvaketta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pointez l’ID, puis cliquez sur l’icône de copie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Punta l’ID, poi fai clic sull’icona di copia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "IDにポインタを合わせて、コピーアイコンをクリックします。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pek på ID-en, og klikk på kopieringsikonet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wijs de ID aan en klik op het kopieericoon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wskaż ID i kliknij ikonę kopiowania."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aponte para o ID e clique no ícone de copiar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Peka på ID:t och klicka på kopieringsikonen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指向 ID，然后点按拷贝图标。"
          }
        }
      }
    },
    "entra-guide.s11.say": {
      "comment": "Sources/Features/EntraGuide (entra-guide lane). machine-translated, owner review pending.",
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiér »Application (client) ID«: peg på det, og klik på kopiikonet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopieren Sie die „Application (client) ID“: Zeigen Sie darauf, und klicken Sie auf das Kopiersymbol."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy the Application (client) ID: point at it and click the copy icon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia el «Application (client) ID»: señálalo y haz clic en el icono de copiar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopioi ”Application (client) ID”: osoita sitä ja napsauta kopiointikuvaketta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiez l’« Application (client) ID » : pointez-le et cliquez sur l’icône de copie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia l’«Application (client) ID»: puntalo e fai clic sull’icona di copia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「Application (client) ID」をコピーします。IDにポインタを合わせ、コピーアイコンをクリックします。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopier «Application (client) ID»: pek på den, og klikk på kopieringsikonet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopieer de “Application (client) ID”: wijs hem aan en klik op het kopieericoon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skopiuj „Application (client) ID”: wskaż je i kliknij ikonę kopiowania."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie o “Application (client) ID”: aponte para ele e clique no ícone de copiar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiera ”Application (client) ID”: peka på det och klicka på kopieringsikonen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拷贝“Application (client) ID”：指向它，然后点按拷贝图标。"
          }
        }
      }
    },
