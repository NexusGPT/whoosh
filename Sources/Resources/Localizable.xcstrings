    "All your inboxes in one fast, quiet window, sorted by a model that never leaves this Mac.": {
      "comment": "FirstStart (Sources/Features/FirstStart/FirstStartWords.swift). machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle dine indbakker i ét hurtigt, roligt vindue, sorteret af en model, der aldrig forlader denne Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Ihre Postfächer in einem schnellen, ruhigen Fenster, sortiert von einem Modell, das diesen Mac nie verlässt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All your inboxes in one fast, quiet window, sorted by a model that never leaves this Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas tus bandejas de entrada en una ventana rápida y tranquila, ordenadas por un modelo que nunca sale de este Mac."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki postilaatikkosi yhdessä nopeassa, rauhallisessa ikkunassa, lajiteltuna mallilla, joka ei koskaan poistu tältä Macilta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
