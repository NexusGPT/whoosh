            "value": "Ce que Whoosh peut relire pour écrire. Tout reste sur ce Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò che Whoosh può rileggere per scrivere. Tutto resta su questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
