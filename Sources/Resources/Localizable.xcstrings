      }
    },
    "The download stopped because the connection dropped. Connect, then tap Resume: it continues where it stopped.": {
      "comment": "Sources/Features/OnDeviceAI/Core/InstallFailureWords.swift:14. machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hentningen stoppede, fordi forbindelsen blev afbrudt. Opret forbindelse, og tryk på Genoptag: den fortsætter, hvor den stoppede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Download wurde gestoppt, weil die Verbindung abbrach. Verbinden Sie sich und tippen Sie auf „Fortsetzen“: Er macht dort weiter, wo er aufgehört hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The download stopped because the connection dropped. Connect, then tap Resume: it continues where it stopped."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La descarga se detuvo porque se perdió la conexión. Conéctate y haz clic en Reanudar: continúa donde se quedó."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lataus pysähtyi, koska yhteys katkesi. Muodosta yhteys ja valitse Jatka: lataus jatkuu siitä, mihin se jäi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléchargement s’est arrêté, la connexion a été perdue. Reconnectez-vous puis touchez Reprendre : il continue où il s’est arrêté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il download si è interrotto perché la connessione è caduta. Connettiti, poi fai clic su Riprendi: continua da dove si era fermato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続が切れたため、ダウンロードが停止しました。接続してから「再開」をクリックすると、中断した位置から続行します。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nedlastingen stoppet fordi forbindelsen ble brutt. Koble til og trykk på Gjenoppta: den fortsetter der den stoppet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De download stopte omdat de verbinding wegviel. Maak verbinding en tik op Hervat: hij gaat verder waar hij stopte."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobieranie zatrzymało się, bo połączenie zostało przerwane. Połącz się i stuknij Wznów: będzie kontynuowane od miejsca przerwania."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O download parou porque a conexão caiu. Conecte-se e clique em Retomar: ele continua de onde parou."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nedladdningen stoppade eftersom anslutningen föll. Anslut och tryck på Återuppta: den fortsätter där den slutade."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于连接中断，下载已停止。请重新连接，然后点按“继续”：它会从停止的位置继续。"
          }
        }
      }
    },
