    "entra-guide.s07.say": {
      "comment": "Sources/Features/EntraGuide (entra-guide lane). machine-translated, owner review pending.",
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn platformslisten under »Redirect URI«, og vælg »Public client/native (mobile & desktop)«."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie unter „Redirect URI“ die Plattformliste, und wählen Sie „Public client/native (mobile & desktop)“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Under Redirect URI, open the platform list and pick Public client/native (mobile & desktop)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En «Redirect URI», abre la lista de plataformas y elige «Public client/native (mobile & desktop)»."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa kohdassa ”Redirect URI” alustaluettelo ja valitse ”Public client/native (mobile & desktop)”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sous « Redirect URI », ouvrez la liste des plateformes et choisissez « Public client/native (mobile & desktop) »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sotto «Redirect URI», apri l’elenco delle piattaforme e scegli «Public client/native (mobile & desktop)»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「Redirect URI」の下でプラットフォームのリストを開き、「Public client/native (mobile & desktop)」を選びます。"
          }
        },
        "nb": {
          "stringUnit": {
