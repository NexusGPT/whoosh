          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De lokale database weigerde de geïmporteerde mail. Wat al is opgeslagen, blijft staan; probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokalna baza danych odrzuciła zaimportowaną pocztę. To, co zapisano, zostaje; spróbuj ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
