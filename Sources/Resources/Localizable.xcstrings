    "Thank you. I need a little more time and will reply by tomorrow.": {
      "comment": "Sources/Features/ComposerMac/ComposerModel+AI.swift:24. machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tak. Jeg har brug for lidt mere tid og svarer i morgen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vielen Dank. Ich brauche etwas mehr Zeit und antworte Ihnen bis morgen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thank you. I need a little more time and will reply by tomorrow."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gracias. Necesito un poco más de tiempo y responderé mañana."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiitos. Tarvitsen hieman lisää aikaa ja vastaan huomiseen mennessä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merci. Il me faut un peu plus de temps et je vous répondrai d’ici demain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Grazie. Mi serve ancora un po’ di tempo e risponderò entro domani."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ありがとうございます。もう少し時間が必要です。明日までに返信します。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Takk. Jeg trenger litt mer tid og svarer i morgen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedankt. Ik heb iets meer tijd nodig en antwoord je morgen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dziękuję. Potrzebuję trochę więcej czasu i odpowiem do jutra."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrigado. Preciso de um pouco mais de tempo e respondo até amanhã."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tack. Jag behöver lite mer tid och svarar i morgon."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "谢谢。我还需要一点时间，明天之前回复您。"
          }
        }
      }
    },
