    "Say what the reply should do, then press Enter.": {
      "comment": "ComposerMac (Sources/Features/ComposerMac/ComposerWords.swift:71). machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
