    "In your words: what belongs here. The AI reads it.": {
      "comment": "Sources/Features/LabelsContactsMac (round 3, the labelling flow). machine-translated, owner review pending. fr as on the board docs/design/boards/labels-flow-r1/v4.html.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Med dine egne ord: hvad der hører hjemme her. AI læser det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In Ihren Worten: was hierhin gehört. Die KI liest es."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In your words: what belongs here. The AI reads it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con tus palabras: qué va aquí. La IA lo lee."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Omin sanoin: mitä tänne kuuluu. Tekoäly lukee sen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec vos mots : ce qui va ici. L'IA le lit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con parole tue: cosa va qui. L'IA lo legge."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの言葉で、ここに入るものを書いてください。AIが読みます。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Med egne ord: hva som hører hjemme her. AI leser det."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In je eigen woorden: wat hier hoort. De AI leest het."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Własnymi słowami: co tu należy. AI to czyta."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Com as suas palavras: o que pertence aqui. A IA lê isto."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Med egna ord: vad som hör hit. AI läser det."
