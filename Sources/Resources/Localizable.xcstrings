        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et annet sett med vilkår: en melding som passer til ett av dem, fanges"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een tweede set voorwaarden: een bericht dat bij een van beide past, wordt opgevangen"
          }
        },
        "pl": {
          "stringUnit": {
