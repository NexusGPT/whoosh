    "Keeps the account and its mail on this Mac, stops fetching and sending.": {
      "comment": "SettingsAccountsMac (Sources/Features/SettingsAccountsMac/AccountsWords.swift:59). machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Beholder kontoen og dens mail på denne Mac, men holder op med at hente og sende."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behält das Konto und seine Mail auf diesem Mac, stoppt Abruf und Versand."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps the account and its mail on this Mac, stops fetching and sending."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene la cuenta y su correo en este Mac; deja de recibir y enviar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pitää tilin ja sen postin tällä Macilla, mutta lopettaa noutamisen ja lähettämisen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde le compte et son courrier sur ce Mac, arrête la réception et l'envoi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene l'account e la sua posta su questo Mac, ma smette di scaricare e inviare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントとメールはこのMacに残したまま、受信と送信を止めます。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Beholder kontoen og e-posten på denne Macen, men slutter å hente og sende."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houdt het account en de mail op deze Mac, stopt met ophalen en versturen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowuje konto i jego pocztę na tym Macu, wstrzymuje pobieranie i wysyłanie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém a conta e o e-mail neste Mac, mas para de receber e enviar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Behåller kontot och dess mejl på den här Macen, men slutar hämta och skicka."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账户和邮件保留在这台 Mac 上,但停止收取和发送。"
          }
        }
      }
    },
