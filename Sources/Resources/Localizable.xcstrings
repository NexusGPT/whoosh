    },
    "New mail is sorted as it arrives. Mail already in the inbox is sorted when you press %@ on a label.": {
      "comment": "SettingsAIMac (Sources/Features/SettingsAIMac/AIWords.swift:52). English and French written by hand; the other 12 machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ny mail sorteres, når den kommer. Mail, der allerede ligger i indbakken, sorteres, når du trykker på %@ ved en etiket."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Mails werden beim Eingang sortiert. Mails, die schon im Posteingang liegen, werden sortiert, wenn Sie bei einem Label %@ drücken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New mail is sorted as it arrives. Mail already in the inbox is sorted when you press %@ on a label."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El correo nuevo se ordena al llegar. El que ya está en la bandeja de entrada se ordena al pulsar %@ en una etiqueta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Uusi posti lajitellaan saapuessaan. Saapuneet kansiossa jo olevat viestit lajitellaan, kun painat nimiön kohdalla %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nouveaux e-mails sont triés à leur arrivée. Ceux déjà dans la boîte de réception le sont quand vous appuyez sur %@ sur un libellé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La posta nuova viene ordinata all’arrivo. Quella già nella posta in arrivo viene ordinata quando premi %@ su un’etichetta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新着メールは届いた時点で振り分けられます。受信箱にあるメールは、ラベルで %@ を押すと振り分けられます。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ny e-post sorteres når den kommer. E-post som allerede ligger i innboksen, sorteres når du trykker %@ på en etikett."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieuwe mail wordt gesorteerd zodra hij binnenkomt. Mail die al in de inbox staat, wordt gesorteerd als je op %@ drukt bij een label."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nowa poczta jest sortowana po otrzymaniu. Poczta już w skrzynce jest sortowana po naciśnięciu %@ przy etykiecie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O correio novo é organizado ao chegar. O que já está na caixa de entrada é organizado quando prime %@ numa etiqueta."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ny post sorteras när den kommer. Post som redan ligger i inkorgen sorteras när du trycker på %@ vid en etikett."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新邮件到达时会自动分类。收件箱中已有的邮件,在你对标签按下 %@ 时分类。"
          }
        }
      }
    },
