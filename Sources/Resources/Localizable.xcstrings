        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikään ei vielä vastaa näitä sanoja. Kansio pysyy tyhjänä, kunnes viesti vastaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun message ne correspond encore. Le dossier reste vide jusqu’à ce qu’un message corresponde."
