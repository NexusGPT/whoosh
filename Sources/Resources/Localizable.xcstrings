    "Labels go %@ levels deep at most, and %@ is already as deep as a label can go here.": {
      "comment": "LabelsContactsMac (Sources/Features/LabelsContactsMac/LabelsWords.swift:35). machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Etiketter kan højst gå %@ niveauer dybt, og %@ er allerede på det dybeste niveau her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Labels reichen höchstens %@ Ebenen tief, und %@ liegt hier schon so tief wie möglich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Labels go %@ levels deep at most, and %@ is already as deep as a label can go here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las etiquetas llegan hasta %@ niveles, y %@ ya es lo más profundo que puede ser una etiqueta aquí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunnisteita voi olla enintään %@ tasoa, ja %@ on jo syvimmällä mahdollisella tasolla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les étiquettes vont jusqu’à %@ niveaux, et %@ est déjà au plus profond ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le etichette arrivano a %@ livelli al massimo, e %@ è già il livello più profondo possibile qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ラベルは最大%@階層までで、%@はすでに最も深い階層です。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Etiketter kan gå maksimalt %@ nivåer dypt, og %@ er allerede på det dypeste nivået her."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Labels gaan maximaal %@ niveaus diep, en %@ zit hier al zo diep als kan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maksymalny poziom etykiet to %@, a %@ jest już na najgłębszym."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As etiquetas vão até %@ níveis, e %@ já é o mais fundo que uma etiqueta pode ficar aqui."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Etiketter kan ligga högst %@ nivåer djupt, och %@ ligger redan på djupaste nivån här."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签最多嵌套%@层,而%@已是此处允许的最深层级。"
          }
        }
      }
    },
    "Labels nest up to %@ levels, like Clients > Provanta.": {
      "comment": "LabelsContactsMac (Sources/Features/LabelsContactsMac/LabelsWords.swift:34). machine-translated, owner review pending.",
