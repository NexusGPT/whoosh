          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voin merkitä nämä %lld viestiä tunnisteella %@. Mikään ei muutu ennen kuin hyväksyt."
          }
        },
        "fr": {
          "stringUnit": {
