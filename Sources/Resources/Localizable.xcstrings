    "entra-guide.s01.cap": {
      "comment": "Sources/Features/EntraGuide (entra-guide lane). machine-translated, owner review pending.",
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Log ind her med din administratorkonto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melden Sie sich hier mit Ihrem Admin-Konto an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in here with your admin account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión aquí con tu cuenta de administrador."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjaudu tähän järjestelmänvalvojan tilillä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous ici avec votre compte administrateur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi qui con il tuo account amministratore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここで管理者アカウントでサインインします。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Logg inn her med administratorkontoen din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Log hier in met je beheerdersaccount."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaloguj się tutaj kontem administratora."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre aqui com sua conta de administrador."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Logga in här med ditt administratörskonto."
          }
        },
        "zh-Hans": {
