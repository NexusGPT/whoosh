            "value": "Klik på en afsenders navn i en besked for at se alt, vedkommende har sendt dig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicken Sie in einer Nachricht auf einen Absendernamen, um alles zu sehen, was er Ihnen geschickt hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click a sender's name in any message to see everything they sent you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en el nombre de un remitente en cualquier mensaje para ver todo lo que te envió."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napsauta lähettäjän nimeä missä tahansa viestissä nähdäksesi kaiken, mitä hän on lähettänyt sinulle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur le nom d’un expéditeur dans un message pour voir tout ce qu’il vous a envoyé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Clicca sul nome di un mittente in qualsiasi messaggio per vedere tutto ciò che ti ha inviato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージ内の送信者名をクリックすると、その人からのメールがすべて表示されます。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Klikk på navnet til en avsender i en melding for å se alt vedkommende har sendt deg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik op de naam van een afzender in een bericht om alles te zien wat hij of zij je stuurde."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
