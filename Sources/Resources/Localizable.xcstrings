    "The server is off, so no app can reach your mail. Start it to let allowed apps connect.": {
      "comment": "McpNotesMac (Sources/Features/McpNotesMac/McpWords.swift:11). machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveren er slået fra, så ingen app kan nå din mail. Start den, så tilladte apps kan oprette forbindelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server ist aus, daher kommt keine App an Ihre Mail. Starten Sie ihn, damit erlaubte Apps sich verbinden können."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server is off, so no app can reach your mail. Start it to let allowed apps connect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor está apagado, así que ninguna app puede acceder a tu correo. Enciéndelo para que las apps permitidas se conecten."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palvelin on pois päältä, joten mikään sovellus ei pääse postiisi. Käynnistä se, niin sallitut apit voivat yhdistää."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur est désactivé, donc aucune app n’accède à vos e-mails. Démarrez-le pour laisser les apps autorisées se connecter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server è spento, quindi nessuna app può raggiungere la tua posta. Avvialo per far connettere le app consentite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバがオフのため、どのアプリもメールに接続できません。許可したアプリを接続するにはサーバを開始してください。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tjeneren er av, så ingen app kan nå e-posten din. Start den slik at tillatte apper kan koble til."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De server staat uit, dus geen app kan bij je mail. Start hem zodat toegestane apps kunnen verbinden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer jest wyłączony, więc żadna aplikacja nie ma dostępu do poczty. Uruchom go, aby dozwolone aplikacje mogły się połączyć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor está desligado, então nenhum app acessa seus e-mails. Ligue-o para os apps permitidos se conectarem."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
