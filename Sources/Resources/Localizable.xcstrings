    "Whoosh forgets the account on this Mac. Your mail stays with your provider.": {
      "comment": "SettingsAccountsMac (Sources/Features/SettingsAccountsMac/AccountsWords.swift:64). machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoosh glemmer kontoen på denne Mac. Din mail forbliver hos udbyderen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoosh vergisst den Account auf diesem Mac. Deine Mail bleibt bei deinem Anbieter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoosh forgets the account on this Mac. Your mail stays with your provider."
          }
