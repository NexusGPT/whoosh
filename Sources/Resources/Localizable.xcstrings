    "Signing in with ChatGPT uses your subscription. OpenAI publishes no policy for this, so it can stop working at any time.": {
      "comment": "SignIn (Sources/Features/SignIn/Engine/OAuthTypes.swift:100). machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Login med ChatGPT bruger dit abonnement. OpenAI udgiver ingen politik for dette, så det kan holde op med at virke når som helst."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung mit ChatGPT nutzt Ihr Abo. OpenAI veröffentlicht dafür keine Richtlinie, daher kann sie jederzeit aufhören zu funktionieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signing in with ChatGPT uses your subscription. OpenAI publishes no policy for this, so it can stop working at any time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar sesión con ChatGPT usa tu suscripción. OpenAI no publica ninguna política al respecto, así que puede dejar de funcionar en cualquier momento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "ChatGPT-kirjautuminen käyttää tilaustasi. OpenAI ei julkaise tästä käytäntöä, joten se voi lakata toimimasta milloin tahansa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se connecter avec ChatGPT utilise votre abonnement. OpenAI ne publie aucune règle à ce sujet, donc cela peut cesser de fonctionner à tout moment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedere con ChatGPT usa il tuo abbonamento. OpenAI non pubblica alcuna policy in merito, quindi potrebbe smettere di funzionare in qualsiasi momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ChatGPTでのサインインはお客様のサブスクリプションを使用します。OpenAIはこれに関する方針を公開していないため、いつでも使えなくなる可能性があります。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pålogging med ChatGPT bruker abonnementet ditt. OpenAI publiserer ingen retningslinjer for dette, så det kan slutte å fungere når som helst."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inloggen met ChatGPT gebruikt je abonnement. OpenAI publiceert hiervoor geen beleid, dus het kan op elk moment stoppen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Logowanie przez ChatGPT korzysta z Twojej subskrypcji. OpenAI nie publikuje w tej sprawie zasad, więc może przestać działać w każdej chwili."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrar com ChatGPT usa sua assinatura. A OpenAI não publica política para isso, então pode parar de funcionar a qualquer momento."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
