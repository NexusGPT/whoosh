    "Reduce Motion on the Mac turns every movement into a fade.": {
      "comment": "SettingsGeneralMac (Sources/Features/SettingsGeneralMac/GeneralWords.swift:60). machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "»Reducer bevægelse« på Mac'en gør al bevægelse til en udtoning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Bewegung reduzieren“ am Mac macht aus jeder Bewegung eine Überblendung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduce Motion on the Mac turns every movement into a fade."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Reducir movimiento» del Mac convierte cada movimiento en un fundido."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Macin Vähennä liikettä -asetus muuttaa kaiken liikkeen häivytykseksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Réduire les animations » du Mac remplace chaque mouvement par un fondu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«Riduci movimento» del Mac trasforma ogni movimento in una dissolvenza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macの「視差効果を減らす」をオンにすると、すべての動きがフェードになります。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "«Reduser bevegelse» på Macen gjør all bevegelse til en inntoning."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beweging verminderen op de Mac verandert elke beweging in een fade."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„Ogranicz ruch” w Macu zamienia każdy ruch w płynne przejście."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "“Reduzir movimento” no Mac transforma cada movimento em um esmaecimento."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”Minska rörelse” på Macen gör varje rörelse till en toning."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启 Mac 的“减弱动态效果”后,所有动画都会变为淡入淡出。"
          }
        }
      }
    },
