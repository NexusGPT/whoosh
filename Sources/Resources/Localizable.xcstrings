    "The notch's full mail loads its pictures at once. Tracking pixels stay blocked.": {
      "comment": "SettingsGeneralMac, Notch (Sources/Features/SettingsGeneralMac/GeneralWords.swift; the notch's alerts, 14 Nov 2026). machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hele mailen i notchen indlæser sine billeder med det samme. Sporingspixels er stadig blokeret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ganze Mail in der Notch lädt ihre Bilder sofort. Tracking-Pixel bleiben blockiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The notch's full mail loads its pictures at once. Tracking pixels stay blocked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El correo completo del notch carga sus imágenes al instante. Los píxeles de seguimiento siguen bloqueados."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Loven koko viesti lataa kuvansa heti. Seurantapikselit pysyvät estettyinä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans le notch, le message complet charge ses images tout de suite. Les pixels de suivi restent bloqués."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La mail completa nel notch carica subito le immagini. I pixel di tracciamento restano bloccati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノッチのメール全体表示では画像をすぐに読み込みます。トラッキングピクセルはブロックされたままです。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hele e-posten i notchen laster inn bildene med en gang. Sporingspiksler er fortsatt blokkert."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De volledige mail in de notch laadt meteen de afbeeldingen. Trackingpixels blijven geblokkeerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pełna wiadomość w notchu od razu wczytuje obrazy. Piksele śledzące pozostają zablokowane."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O e-mail completo no notch carrega as imagens na hora. Os pixels de rastreamento continuam bloqueados."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hela mejlet i notchen läser in sina bilder direkt. Spårningspixlar förblir blockerade."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刘海中的完整邮件会立即加载图片。跟踪像素仍被拦截。"
