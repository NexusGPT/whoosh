          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hva Whoosh kan lese på nytt for å skrive. Alt blir på denne Macen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat Whoosh opnieuw mag lezen om te schrijven. Alles blijft op deze Mac."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To, co Whoosh może ponownie czytać, by pisać. Wszystko zostaje na tym Macu."
          }
        },
        "pt": {
