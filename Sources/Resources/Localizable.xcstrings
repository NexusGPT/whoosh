    "The microphone is off for Whoosh. Open System Settings, Privacy and Security, Microphone, and turn Whoosh on.": {
      "comment": "Dictation (Sources/Features/Dictation/Core/DictationTypes.swift:15). machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonen er slået fra for Whoosh. Åbn Systemindstillinger, Anonymitet og sikkerhed, Mikrofon, og slå Whoosh til."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Mikrofon ist für Whoosh ausgeschaltet. Öffnen Sie Systemeinstellungen, Datenschutz & Sicherheit, Mikrofon, und schalten Sie Whoosh ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The microphone is off for Whoosh. Open System Settings, Privacy and Security, Microphone, and turn Whoosh on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El micrófono está desactivado para Whoosh. Abre Ajustes del Sistema, Privacidad y seguridad, Micrófono, y activa Whoosh."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofoni on pois päältä Whooshilta. Avaa Järjestelmäasetukset, Tietosuoja ja suojaus, Mikrofoni, ja ota Whoosh käyttöön."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le micro est désactivé pour Whoosh. Ouvrez Réglages Système, Confidentialité et sécurité, Micro, et activez Whoosh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il microfono è disattivato per Whoosh. Apri Impostazioni di Sistema, Privacy e sicurezza, Microfono, e attiva Whoosh."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Whooshのマイクがオフです。システム設定の「プライバシーとセキュリティ」「マイク」でWhooshをオンにしてください。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonen er av for Whoosh. Åpne Systeminnstillinger, Personvern og sikkerhet, Mikrofon, og slå på Whoosh."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De microfoon staat uit voor Whoosh. Open Systeeminstellingen, Privacy en beveiliging, Microfoon, en zet Whoosh aan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon jest wyłączony dla Whoosh. Otwórz Ustawienia systemowe, Prywatność i ochrona, Mikrofon, i włącz Whoosh."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O microfone está desativado para o Whoosh. Abra Ajustes do Sistema, Privacidade e Segurança, Microfone, e ative o Whoosh."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonen är av för Whoosh. Öppna Systeminställningar, Integritet och säkerhet, Mikrofon, och slå på Whoosh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoosh的麦克风已关闭。请打开“系统设置”的“隐私与安全性”,进入“麦克风”,开启Whoosh。"
          }
        }
      }
    },
