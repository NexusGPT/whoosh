    "Every “ask the model” entry is skipped; each list falls through.": {
      "comment": "SettingsAIMac (Sources/Features/SettingsAIMac/AIWords.swift:37). machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver “spørg modellen”-post springes over; hver liste går videre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Eintrag „Modell fragen“ wird übersprungen; jede Liste geht zum nächsten Eintrag über."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every “ask the model” entry is skipped; each list falls through."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se omite cada entrada de “preguntar al modelo”; cada lista pasa a la siguiente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokainen “kysy mallilta” -merkintä ohitetaan; kukin lista siirtyy seuraavaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque entrée « interroger le modèle » est ignorée ; chaque liste passe à la suivante."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni voce “chiedi al modello” viene saltata; ogni elenco passa oltre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「モデルに質問」のエントリはすべてスキップされ、各リストは次へ進みます。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver «spør modellen»-oppføring hoppes over; hver liste går videre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk item “vraag het model” wordt overgeslagen; elke lijst gaat door naar het volgende."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy wpis „zapytaj model” jest pomijany; każda lista przechodzi dalej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda entrada “perguntar ao modelo” é ignorada; cada lista segue para a próxima."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje post med ”fråga modellen” hoppas över; varje lista går vidare."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个“询问模型”条目都会被跳过;各列表依次往下。"
          }
        }
      }
    },
