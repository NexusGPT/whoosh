        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De betekeniszoekopdracht kon deze keer niet worden uitgevoerd. Eerst exacte treffers, dan de overige mails op datum."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyszukiwanie według znaczenia nie powiodło się tym razem. Najpierw dokładne dopasowania, potem pozostałe wiadomości według daty."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
