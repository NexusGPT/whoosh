    "Whoosh needs Full Disk Access to read Apple Mail.": {
      "comment": "SettingsAccountsMac (Sources/Features/SettingsAccountsMac/AccountsWords.swift:92). English and French written by hand; the other 12 machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoosh har brug for fuld diskadgang for at læse Apple Mail."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoosh braucht den Vollzugriff auf die Festplatte, um Apple Mail zu lesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoosh needs Full Disk Access to read Apple Mail."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoosh necesita acceso total al disco para leer Apple Mail."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoosh tarvitsee täyden levyn käyttöoikeuden lukeakseen Apple Mailia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoosh a besoin de l’accès complet au disque pour lire Apple Mail."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoosh ha bisogno dell’accesso completo al disco per leggere Apple Mail."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Mail を読み込むには、Whoosh にフルディスクアクセスが必要です。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoosh trenger full disktilgang for å lese Apple Mail."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
