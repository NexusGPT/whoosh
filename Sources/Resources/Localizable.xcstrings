    "Jev decides, with your key and your consent.": {
      "comment": "AISetup (Sources/Features/AISetup/AISetupWords.swift:22). English and French written by hand; the other 12 machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Jev beslutter, med din nøgle og dit samtykke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jev entscheidet, mit Ihrem Schlüssel und Ihrer Zustimmung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jev decides, with your key and your consent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Jev decide, con tu clave y tu consentimiento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jev päättää avaimellasi ja suostumuksellasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jev décide, avec votre clé et votre accord."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Jev decide, con la tua chiave e il tuo consenso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Jev があなたのキーと同意をもとに判断します。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Jev bestemmer, med nøkkelen din og samtykket ditt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jev beslist, met jouw sleutel en jouw toestemming."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jev decyduje, z twoim kluczem i twoją zgodą."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Jev decide, com a sua chave e o seu consentimento."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jev bestämmer, med din nyckel och ditt samtycke."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Jev 使用你的密钥并经你同意后做出决策。"
          }
        }
      }
    },
    "Jev has no key: add it in Settings, Decisions.": {
      "comment": "LabelsContactsMac (Sources/Features/LabelsContactsMac/LabelFlowModel.swift, LabelProofRow.swift). machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Jev har ingen nøgle: tilføj den i Indstillinger, Beslutninger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jev hat keinen Schlüssel: Fügen Sie ihn in den Einstellungen unter Entscheidungen hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jev has no key: add it in Settings, Decisions."
          }
