    "Off removes the emblem and gives the text its width back.": {
      "comment": "SettingsGeneralMac (Sources/Features/SettingsGeneralMac/GeneralWords.swift:39). machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fra fjerner emblemet og giver teksten sin bredde tilbage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus entfernt das Emblem und gibt dem Text seine Breite zurück."
