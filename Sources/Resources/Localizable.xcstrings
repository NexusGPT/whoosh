    "Opens the notch from any app, with the keyboard in it. The same key closes it.": {
      "comment": "Settings > Notifications, the notch's key (Sources/Features/SettingsGeneralMac/GeneralWords.swift, 14 Nov 2026). machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbner notchen fra enhver app, med tastaturet i den. Den samme tast lukker den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet die Notch aus jeder App, mit der Tastatur darin. Dieselbe Taste schließt sie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens the notch from any app, with the keyboard in it. The same key closes it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre el notch desde cualquier app, con el teclado en él. La misma tecla lo cierra."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa lovekkeen mistä tahansa apista, näppäimistö siinä. Sama näppäin sulkee sen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre l’encoche depuis n’importe quelle app, avec le clavier dedans. La même touche la ferme."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre il notch da qualsiasi app, con la tastiera al suo interno. Lo stesso tasto lo chiude."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのアプリからでもノッチを開き、キーボードをノッチに移します。同じキーで閉じます。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpner notchen fra hvilken som helst app, med tastaturet i den. Den samme tasten lukker den."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent de notch vanuit elke app, met het toetsenbord erin. Dezelfde toets sluit hem."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwiera notch z dowolnej aplikacji, z klawiaturą w nim. Ten sam klawisz go zamyka."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o notch de qualquer app, com o teclado nele. A mesma tecla o fecha."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppnar notchen från vilken app som helst, med tangentbordet i den. Samma tangent stänger den."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从任何 App 打开刘海，键盘随之进入刘海。同一按键可将其关闭。"
          }
        }
      }
    },
