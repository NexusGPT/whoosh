    "Microsoft no longer accepts passwords for mail. Sign in with your organisation’s app ID below.": {
      "comment": "AddAccount (Sources/Features/AddAccount/AddAccountWords.swift, causeSentence basic_auth_disabled, SPEC A87). machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Microsoft accepterer ikke længere adgangskoder til mail. Log ind med din organisations app-ID nedenfor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Microsoft akzeptiert keine Passwörter mehr für E-Mail. Melden Sie sich unten mit der App-ID Ihrer Organisation an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Microsoft no longer accepts passwords for mail. Sign in with your organisation’s app ID below."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Microsoft ya no acepta contraseñas para el correo. Inicia sesión abajo con el ID de app de tu organización."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Microsoft ei enää hyväksy salasanoja sähköpostiin. Kirjaudu alla organisaatiosi sovellustunnuksella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Microsoft n’accepte plus les mots de passe pour le courrier. Connectez-vous ci-dessous avec l’ID d’app de votre organisation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Microsoft non accetta più password per la posta. Accedi qui sotto con l’ID app della tua organizzazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Microsoft はメールでパスワードを受け付けなくなりました。下で組織のアプリIDを使ってサインインしてください。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Microsoft godtar ikke lenger passord for e-post. Logg på med organisasjonens app-ID nedenfor."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Microsoft accepteert geen wachtwoorden meer voor mail. Log hieronder in met de app-ID van je organisatie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Microsoft nie przyjmuje już haseł do poczty. Zaloguj się poniżej identyfikatorem aplikacji swojej organizacji."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A Microsoft já não aceita palavras-passe para o correio. Inicie sessão abaixo com o ID de app da sua organização."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Microsoft godtar inte längre lösenord för e-post. Logga in med organisationens app-ID nedan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Microsoft 已不再接受邮件密码。请在下方使用你所在组织的应用 ID 登录。"
          }
        }
      }
    },
    "Microsoft turned off password sign-in for IMAP in 2022, so a password cannot work here. Paste your organisation’s app ID to sign in.": {
      "comment": "Sources/Features/AddAccount/AddAccountWords.swift:35. machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Microsoft slog i 2022 adgangskodelogin til IMAP fra, så en adgangskode kan ikke virke her. Indsæt din organisations app-ID for at logge ind."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Microsoft hat die Passwort-Anmeldung für IMAP 2022 abgeschaltet, ein Passwort kann hier also nicht funktionieren. Fügen Sie die App-ID Ihrer Organisation ein, um sich anzumelden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Microsoft turned off password sign-in for IMAP in 2022, so a password cannot work here. Paste your organisation’s app ID to sign in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Microsoft desactivó en 2022 el inicio de sesión con contraseña para IMAP, así que una contraseña no puede funcionar aquí. Pega el ID de app de tu organización para iniciar sesión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Microsoft poisti salasanakirjautumisen IMAPista vuonna 2022, joten salasana ei toimi tässä. Liitä organisaatiosi sovellustunnus kirjautuaksesi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Microsoft a désactivé la connexion par mot de passe pour IMAP en 2022 : un mot de passe ne peut pas fonctionner ici. Collez l’ID d’app de votre organisation pour vous connecter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Microsoft ha disattivato nel 2022 l’accesso con password per IMAP, quindi qui una password non può funzionare. Incolla l’ID app della tua organizzazione per accedere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Microsoftは2022年にIMAPのパスワード認証を無効にしたため、ここではパスワードは使えません。組織のアプリIDを貼り付けてサインインしてください。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Microsoft slo i 2022 av passordpålogging for IMAP, så et passord kan ikke fungere her. Lim inn organisasjonens app-ID for å logge inn."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Microsoft heeft in 2022 aanmelden met een wachtwoord voor IMAP uitgezet, dus een wachtwoord kan hier niet werken. Plak de app-ID van je organisatie om aan te melden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Microsoft wyłączył w 2022 r. logowanie hasłem do IMAP, więc hasło tu nie zadziała. Wklej ID aplikacji swojej organizacji, aby się zalogować."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A Microsoft desativou em 2022 o login por senha para IMAP, então uma senha não funciona aqui. Cole o ID de app da sua organização para entrar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Microsoft stängde 2022 av lösenordsinloggning för IMAP, så ett lösenord kan inte fungera här. Klistra in din organisations app-ID för att logga in."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Microsoft 已于 2022 年关闭 IMAP 的密码登录，因此这里无法使用密码。请粘贴你所在组织的应用 ID 来登录。"
          }
        }
      }
    },
