          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyckelringen på den här datorn sparade inte ID:t. Inget skickades. Detaljerna visar nyckelringens egna ord."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
