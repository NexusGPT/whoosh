    "Pick a picture and a colour. You see it on your list, in the sidebar and in each message.": {
      "comment": "SettingsAccountsMac (Sources/Features/SettingsAccountsMac/AccountsWords.swift:34). machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg et billede og en farve. Du ser det på din liste, i sidepanelet og i hver besked."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie ein Bild und eine Farbe. Sie sehen es in Ihrer Liste, in der Seitenleiste und in jeder Nachricht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a picture and a colour. You see it on your list, in the sidebar and in each message."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una imagen y un color. Los verás en tu lista, en la barra lateral y en cada mensaje."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse kuva ja väri. Näet ne luettelossasi, sivupalkissa ja jokaisessa viestissä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une image et une couleur. Vous la voyez dans votre liste, dans la barre latérale et dans chaque message."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un’immagine e un colore. Li vedi nell’elenco, nella barra laterale e in ogni messaggio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像とカラーを選んでください。リスト、サイドバー、各メッセージに表示されます。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg et bilde og en farge. Du ser det i listen din, i sidepanelet og i hver melding."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een afbeelding en een kleur. Je ziet ze in je lijst, in de navigatiekolom en bij elk bericht."
