    "Off asks first in each mail. Tracking pixels are never loaded. Mail in Junk always asks first.": {
      "comment": "The caption of the pictures switch in Settings > General > Privacy",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fra spørger først i hver mail. Sporingspixels indlæses aldrig. Mail i Uønsket post spørger altid først."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus fragt in jeder Mail zuerst. Tracking-Pixel werden nie geladen. Mails in Junk fragen immer zuerst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off asks first in each mail. Tracking pixels are never loaded. Mail in Junk always asks first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado pregunta primero en cada correo. Los píxeles de seguimiento nunca se cargan. El correo no deseado siempre pregunta primero."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pois päältä kysyy ensin jokaisessa viestissä. Seurantapikseleitä ei koskaan ladata. Roskapostissa kysytään aina ensin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé demande d’abord dans chaque e-mail. Les pixels de suivi ne sont jamais chargés. Les e-mails des Indésirables demandent toujours d’abord."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivato chiede prima in ogni email. I pixel di tracciamento non vengono mai caricati. La posta indesiderata chiede sempre prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフにすると、メールごとに先に確認します。トラッキングピクセルは読み込まれません。迷惑メールでは常に先に確認します。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Av spør først i hver e-post. Sporingspiksler lastes aldri. E-post i Søppelpost spør alltid først."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uit vraagt eerst in elke mail. Trackingpixels worden nooit geladen. Mail in Ongewenst vraagt altijd eerst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyłączone pyta najpierw w każdej wiadomości. Piksele śledzące nigdy nie są wczytywane. Wiadomości-śmieci zawsze pytają najpierw."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado pergunta primeiro em cada e-mail. Os píxeis de rastreio nunca são carregados. O lixo eletrônico pergunta sempre primeiro."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Av frågar först i varje mejl. Spårningspixlar hämtas aldrig. Mejl i Skräppost frågar alltid först."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后，每封邮件会先询问。绝不加载追踪像素。垃圾邮件中的邮件始终先询问。"
          }
        }
      }
    },
