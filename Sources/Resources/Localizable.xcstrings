    "Ask a question first. I label the messages an answer cites.": {
      "comment": "AskMac (Sources/Features/AskMac/AskWords.swift:13). machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stil først et spørgsmål. Jeg sætter etiket på de beskeder, et svar henviser til."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellen Sie zuerst eine Frage. Ich labele die zitierten Nachrichten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask a question first. I label the messages an answer cites."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz primero una pregunta. Etiqueto los mensajes que cita una respuesta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Esitä ensin kysymys. Merkitsen tunnisteella viestit, joihin vastaus viittaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Posez d’abord une question. J’étiquette les messages cités."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai prima una domanda. Etichetto i messaggi citati da una risposta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先に質問してください。回答が引用したメッセージにラベルを付けます。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Still et spørsmål først. Jeg setter etikett på meldingene et svar viser til."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel eerst een vraag. Ik label de berichten die een antwoord noemt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw zadaj pytanie. Oznaczę etykietą wiadomości, które cytuje odpowiedź."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça uma pergunta primeiro. Eu etiqueto as mensagens que uma resposta cita."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ställ en fråga först. Jag sätter etikett på meddelandena som ett svar hänvisar till."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先提问。我会为回答所引用的邮件添加标签。"
          }
        }
      }
    },
