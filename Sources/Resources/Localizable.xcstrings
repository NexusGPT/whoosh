    "The meaning search could not run this time. Exact matches first, then the other mails by date.": {
      "comment": "Sources/Features/SearchMac/SearchMacModel.swift. machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Betydningssøgningen kunne ikke køre denne gang. Eksakte match først, derefter de øvrige mails efter dato."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bedeutungssuche konnte diesmal nicht laufen. Zuerst exakte Treffer, dann die übrigen Mails nach Datum."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The meaning search could not run this time. Exact matches first, then the other mails by date."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La búsqueda por significado no pudo ejecutarse esta vez. Primero las coincidencias exactas, después el resto de correos por fecha."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Merkityshaku ei onnistunut tällä kertaa. Ensin tarkat osumat, sitten muut viestit päiväyksen mukaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La recherche par le sens n’a pas pu s’exécuter cette fois. D’abord les résultats exacts, puis les autres e-mails par date."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La ricerca per significato non è riuscita questa volta. Prima le corrispondenze esatte, poi le altre email per data."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今回は意味の検索を実行できませんでした。完全一致を先に、その他のメールは日付順に表示します。"
