    "Send excerpts of the matching messages to %@ to answer? Whoosh asks once per provider.": {
      "comment": "AskMac (Sources/Features/AskMac/AskWords.swift:28). machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Send uddrag af de matchende beskeder til %@ for at svare? Whoosh spørger én gang pr. udbyder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auszüge der passenden Nachrichten zur Antwort an %@ senden? Whoosh fragt einmal pro Anbieter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send excerpts of the matching messages to %@ to answer? Whoosh asks once per provider."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Enviar fragmentos de los mensajes coincidentes a %@ para responder? Whoosh pregunta una vez por proveedor."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähetetäänkö otteita vastaavista viesteistä palveluun %@ vastausta varten? Whoosh kysyy kerran palveluntarjoajaa kohden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyer des extraits des messages trouvés à %@ pour répondre ? Whoosh demande une fois par fournisseur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inviare estratti dei messaggi corrispondenti a %@ per rispondere? Whoosh chiede una volta per provider."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一致したメッセージの抜粋を%@に送って回答を作成しますか?Whooshはプロバイダごとに1回だけ確認します。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sende utdrag av de samsvarende meldingene til %@ for å svare? Whoosh spør én gang per leverandør."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragmenten van de gevonden berichten naar %@ sturen om te antwoorden? Whoosh vraagt dit één keer per aanbieder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysłać fragmenty pasujących wiadomości do %@, aby odpowiedzieć? Whoosh pyta raz dla każdego dostawcy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar trechos das mensagens correspondentes para %@ para responder? O Whoosh pergunta uma vez por provedor."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skicka utdrag ur de matchande meddelandena till %@ för att besvara? Whoosh frågar en gång per leverantör."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要将匹配邮件的摘录发送给%@以生成回答吗?Whoosh对每个提供商只询问一次。"
          }
        }
      }
    },
