          "stringUnit": {
            "state": "translated",
            "value": "このラベルは%@のみに適用されるため、%@のメールには一致しません。「適用先」を変更するか、ルールを削除してください。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Etiketten gjelder bare %@ og kan derfor ikke passe til e-post fra %@. Endre Gjelder for, eller fjern regelen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het label geldt alleen voor %@ en kan dus geen mail van %@ vangen. Wijzig Geldt voor, of verwijder de regel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Etykieta dotyczy tylko: %@, więc nie może pasować do wiadomości z: %@. Zmień “Dotyczy” lub usuń regułę."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A etiqueta só se aplica a %@, então não pode corresponder a e-mails de %@. Mude Aplica-se a ou remova a regra."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Etiketten gäller bara %@ och kan därför inte matcha e-post från %@. Ändra Gäller för eller ta bort regeln."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该标签仅适用于 %@，因此无法匹配 %@ 的邮件。请更改“适用于”，或移除该规则。"
          }
        }
      }
    },
    "The last count stays until the new one lands. Typing never waits for it.": {
      "comment": "Sources/Features/LabelsContactsMac/LabelProofViews.swift:89. machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det seneste antal står, indtil det nye kommer. Det er aldrig nødvendigt at vente på det, mens du skriver."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die letzte Zählung bleibt, bis die neue da ist. Das Tippen wartet nie darauf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The last count stays until the new one lands. Typing never waits for it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El último recuento se mantiene hasta que llega el nuevo. Escribir nunca espera por él."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viimeisin määrä säilyy, kunnes uusi tulee. Kirjoittaminen ei koskaan odota sitä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dernier décompte reste affiché jusqu’au nouveau. La saisie n’attend jamais."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ultimo conteggio resta finché non arriva il nuovo. Scrivere non lo aspetta mai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい件数が出るまで前回の件数が表示されます。入力が待たされることはありません。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det siste antallet blir stående til det nye kommer. Du trenger aldri vente på det mens du skriver."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De laatste telling blijft staan tot de nieuwe er is. Typen wacht er nooit op."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostatni wynik liczenia zostaje, dopóki nie pojawi się nowy. Pisanie nigdy na niego nie czeka."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A última contagem fica até a nova chegar. Digitar nunca espera por ela."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det senaste antalet står kvar tills det nya kommer. Du behöver aldrig vänta på det när du skriver."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新的数量出现之前会保留上次的数量。输入不会因此等待。"
          }
        }
      }
    },
