    "Your settings travel between your devices, encrypted, on your own iCloud.": {
      "comment": "SettingsPhone (Sources/Features/SettingsPhone/SettingsPhoneWords.swift:40). machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine indstillinger rejser krypteret mellem dine enheder via din egen iCloud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Einstellungen werden verschlüsselt über Ihr eigenes iCloud zwischen Ihren Geräten übertragen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your settings travel between your devices, encrypted, on your own iCloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus ajustes viajan cifrados entre tus dispositivos, a través de tu propio iCloud."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Asetuksesi siirtyvät laitteiden välillä salattuina omassa iCloudissasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos réglages passent d’un appareil à l’autre, chiffrés, via votre propre iCloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue impostazioni viaggiano cifrate tra i tuoi dispositivi, sul tuo iCloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定は暗号化され、あなた自身のiCloudを通じてデバイス間で受け渡されます。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Innstillingene dine reiser kryptert mellom enhetene dine, via din egen iCloud."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je instellingen reizen versleuteld tussen je apparaten, via je eigen iCloud."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje ustawienia są przesyłane szyfrowane między Twoimi urządzeniami przez Twój własny iCloud."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus ajustes viajam criptografados entre seus dispositivos, pelo seu próprio iCloud."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina inställningar färdas krypterade mellan dina enheter, via ditt eget iCloud."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的设置经加密后，通过你自己的 iCloud 在设备间同步。"
          }
        }
      }
    },
