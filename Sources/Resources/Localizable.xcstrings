    "The AI keeps an excerpt only when it answers yes to this question.": {
      "comment": "SettingsRepliesMac (docs/lanes/settingsreplies-mac.md), joined by settings-integrate. machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "AI’en beholder kun et uddrag, hvis den svarer ja til dette spørgsmål."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die KI behält einen Auszug nur, wenn sie diese Frage mit Ja beantwortet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The AI keeps an excerpt only when it answers yes to this question."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La IA solo conserva un extracto si responde que sí a esta pregunta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekoäly säilyttää otteen vain, jos vastaa tähän kysymykseen kyllä."
          }
        },
        "fr": {
