            "value": "%lld liittyy tunnisteeseen %@, %lld poistuu, %lld pysyy. Valinta Ei nyt säilyttää nykyisen lajittelun."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld rejoignent %@, %lld quitte, %lld restent. Pas maintenant garde le classement actuel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld entrano in %@, %lld escono e %lld restano. Non ora mantiene la classificazione attuale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld通が%@に加入、%lld通が外れ、%lld通は変更なし。「今はしない」を選ぶと現在の分類が維持されます。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld blir med i %@, %lld forlater, %lld blir. Ikke nå beholder dagens sortering."
          }
