        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ou solte uma aqui. Ela é cortada em quadrado."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Eller släpp en här. Den beskärs till en kvadrat."
