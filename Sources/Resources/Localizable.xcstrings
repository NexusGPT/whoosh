    "All is every message of the inbox, not a place: pick a label, Primary or Junk": {
      "comment": "Sources/Features/LabelsContactsMac (round 3, the labelling flow). machine-translated, owner review pending. fr as on the board docs/design/boards/labels-flow-r1/v4.html.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle er hver besked i indbakken, ikke et sted: vælg en etiket, Primær eller Spam"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle ist jede Nachricht des Eingangs, kein Ort: Wählen Sie ein Label, Primär oder Junk"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All is every message of the inbox, not a place: pick a label, Primary or Junk"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos es cada mensaje del buzón, no un lugar: elige una etiqueta, Principal o Correo no deseado"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki on jokainen saapuneiden viesti, ei paikka: valitse tunniste, Ensisijaiset tai Roskaposti"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous, c'est chaque message de la boîte, pas un endroit : choisissez une étiquette, Principal ou Indésirables"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti è ogni messaggio della posta, non un posto: scegli un'etichetta, Principale o Posta indesiderata"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「すべて」は受信トレイの全メッセージで、行き先ではありません。ラベル、メイン、迷惑メールから選んでください"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle er hver melding i innboksen, ikke et sted: velg en etikett, Primær eller Søppelpost"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
