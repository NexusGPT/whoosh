    "Jev may not see your mail until you agree to it once: agree in Settings, Decisions.": {
      "comment": "LabelsContactsMac (Sources/Features/LabelsContactsMac/LabelFlowModel.swift, LabelProofRow.swift). machine-translated, owner review pending.",
      "extractionState": "extracted_with_value",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Jev må ikke se din post, før du har sagt ja én gang: sig ja i Indstillinger, Beslutninger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jev darf Ihre Post erst sehen, wenn Sie einmal zugestimmt haben: Stimmen Sie in den Einstellungen unter Entscheidungen zu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jev may not see your mail until you agree to it once: agree in Settings, Decisions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Jev no puede ver su correo hasta que lo acepte una vez: acepte en Ajustes, Decisiones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jev ei saa nähdä postiasi ennen kuin hyväksyt sen kerran: hyväksy Asetukset-kohdan Päätökset-osiossa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jev ne peut pas voir votre courrier tant que vous ne l’avez pas accepté une fois : acceptez dans Réglages, Décisions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Jev non può vedere la vostra posta finché non acconsentite una volta: acconsentite in Impostazioni, Decisioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度同意するまで、Jev はメールを見ることができません。設定の「判断」で同意してください。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Jev får ikke se e-posten din før du har sagt ja én gang: si ja i Innstillinger, Beslutninger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jev mag je e-mail pas zien nadat je één keer akkoord bent gegaan: ga akkoord in Instellingen, Beslissingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jev nie może widzieć Twojej poczty, dopóki raz się na to nie zgodzisz: zgódź się w Ustawieniach, Decyzje."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Jev não pode ver o seu correio até concordar uma vez: concorde em Definições, Decisões."
          }
        },
        "sv": {
          "stringUnit": {
