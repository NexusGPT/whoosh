            "value": "La nuova posta non arriva più subito su questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新着メールはこのMacにすぐには届かなくなりました。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ny e-post leveres ikke lenger umiddelbart til denne Macen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieuwe e-mail komt niet meer direct binnen op deze Mac."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nowa poczta nie trafia już od razu na tego Maca."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os novos e-mails não chegam mais instantaneamente a este Mac."
          }
        },
        "sv": {
