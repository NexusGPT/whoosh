    "entra-guide.s01.say": {
      "comment": "Sources/Features/EntraGuide (entra-guide lane). machine-translated, owner review pending.",
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn Microsofts administrationsside, og log ind med din administratorkonto fra arbejdet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie die Admin-Seite von Microsoft, und melden Sie sich mit Ihrem Admin-Konto an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Microsoft’s admin page and sign in with your work admin account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la página de administración de Microsoft e inicia sesión con tu cuenta de administrador del trabajo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa Microsoftin hallintasivu ja kirjaudu sisään työpaikan järjestelmänvalvojan tilillä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez la page d’administration de Microsoft et connectez-vous avec votre compte administrateur professionnel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri la pagina di amministrazione di Microsoft e accedi con il tuo account amministratore di lavoro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Microsoftの管理ページを開き、勤務先の管理者アカウントでサインインします。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne Microsofts administrasjonsside, og logg inn med administratorkontoen din på jobben."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open de beheerpagina van Microsoft en log in met je beheerdersaccount voor werk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz stronę administracyjną Microsoft i zaloguj się kontem administratora firmowego."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra a página de administração da Microsoft e entre com sua conta de administrador do trabalho."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna Microsofts administrationssida och logga in med ditt administratörskonto för jobbet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Microsoft 管理页面，用你的工作管理员账户登录。"
          }
        }
      }
    },
    "entra-guide.s02.cap": {
