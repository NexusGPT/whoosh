# Whoosh relay configuration. Copy to .env (never commit it) and fill in your own values.
# Every value below is a placeholder. The relay has no built-in host, key or account.

# --- Where it listens and stores ---------------------------------------------------------------
# Address to listen on. Unset: 127.0.0.1 on a free port. If unset and PORT is set: 0.0.0.0:$PORT.
RELAY_BIND=0.0.0.0:8080
# SQLite file. Keep it on a disk that survives restarts.
RELAY_DB=/data/relay.sqlite3
# The public https address of THIS relay, used in the tracking pixel and link addresses it hands out.
RELAY_PUBLIC_BASE_URL=https://relay.example.com
# Log level (tracing filter), for example info or relay=debug.
RUST_LOG=info

# --- Apple push (APNs) --------------------------------------------------------------------------
# Give the .p8 key as a file OR inline. The path wins when both are set. Without a key the relay
# still starts, reports "degraded" on /v1/health, and keeps the push jobs queued.
RELAY_APNS_KEY_PATH=/run/secrets/AuthKey_XXXXXXXXXX.p8
# RELAY_APNS_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
RELAY_APNS_KEY_ID=XXXXXXXXXX
RELAY_APNS_TEAM_ID=YYYYYYYYYY
# The bundle id of the iPhone app, for example com.example.whoosh.
RELAY_APNS_TOPIC=com.example.whoosh
# Optional. Defaults are Apple's own hosts; change them only to point at a test stand-in.
# RELAY_APNS_SANDBOX_URL=
# RELAY_APNS_PRODUCTION_URL=

# --- Secrets the relay signs with (set all three on a hosted relay; any long random string) -----
# Signs the tracking links. Unset: a random key per start, so links die on restart.
RELAY_TRACKING_KEY=
# Keeps provider bindings valid across restarts. Unset: a random key per start.
RELAY_BINDING_KEY=
# Turns on POST /v1/inbound/loopback (a trusted caller sends signals with this bearer token). Unset: off.
RELAY_SIGNAL_TOKEN=

# --- Provider adapters (leave a family unset to leave it unused) --------------------------------
# Gmail through Pub/Sub: the Google-signed push token is checked against these.
# RELAY_GMAIL_JWKS_PATH=/etc/relay/google-jwks.json
# RELAY_GMAIL_AUDIENCE=https://relay.example.com/v1/inbound/gmail
# RELAY_GMAIL_PUSH_ACCOUNT=pubsub-push@your-project.iam.gserviceaccount.com
# Microsoft Graph: minutes before expiry at which a subscription renews. Default is in docs/CONSTANTS.md.
# RELAY_GRAPH_RENEW_MARGIN_MIN=
